# dependencies
node_modules/

# build output
dist/

# OG-картинки генерируются на сборке (scripts/make-og.mjs)
public/og/

# Токены тем генерируются из src/themes/tokens.ts (scripts/gen-theme-tokens.mjs)
src/themes/generated/

# Файлы шрифтов копируются из пакетов Fontsource (scripts/sync-fonts.mjs):
# в репозиторий не попадают, чтобы версия шрифта не разъезжалась с npm.
# Шаг есть в «Быстром старте», в deploy/README.md и в CI перед сборкой.
# Рукописные @font-face и адреса субсетов (src/fonts/*.css, src/fonts/*.urls.ts)
# при этом коммитятся: это исходники, а не вывод скрипта.
src/assets/fonts/

# generated types
.astro/

# environment
.env
.env.local
.env.*.local
!.env.example

# tooling
*.log
npm-debug.log*
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json

# temp
*.tmp
.cache/

.commandcode/
.agents/
skills-lock.json
