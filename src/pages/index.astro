---
import PageRoute from '../components/PageRoute.astro';
import { DEFAULT_LOCALE } from '../i18n/config';
import { generatedRoutes } from '../i18n/routes';

/**
 * Главная страница языка по умолчанию — сербский (латиница).
 *
 * Живёт в корне домена: так локальный поиск получает самый сильный сигнал,
 * и ровно так устроены сайты основных конкурентов (uborka.rs, cleanhouse.rs,
 * shinecleaning.rs) — сербский в корне, остальные языки в подпапках.
 *
 * Главная собирает все блоки из src/data/pages.ts — по ней видно
 * оформление сайта целиком.
 */

/** Главная — единственная страница реестра с пустым слагом. */
const home = generatedRoutes([DEFAULT_LOCALE]).find((route) => route.key === 'home');

if (!home) {
  throw new Error('Главная страница отсутствует в реестре маршрутов.');
}
---

<PageRoute locale={home.locale} routeKey={home.key} />
