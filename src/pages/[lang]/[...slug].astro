---
import Base from '../../layouts/Base.astro';
import PageBody from '../../components/PageBody.astro';
import type { Locale } from '../../i18n/config';
import { generatedRoutes, NON_DEFAULT_LOCALES, type PageKey } from '../../i18n/routes';

/**
 * Внутренние страницы языков, живущих в подпапке: /en/... и /ru/...
 *
 * Слаги берутся из реестра маршрутов, поэтому адреса переведены
 * (/cene | /en/prices | /ru/ceny), а не просто получили префикс языка.
 * Один файл обслуживает все внутренние страницы двух локалей.
 */
export function getStaticPaths() {
  return generatedRoutes(NON_DEFAULT_LOCALES).map((route) => {
    // Первый сегмент — сама локаль, остальные образуют слаг страницы.
    // Пустой массив означает главную страницу локали (/en/ или /ru/),
    // поэтому slug передаём как undefined.
    const rest = route.segments.slice(1);

    return {
      params: { lang: route.locale, slug: rest.length > 0 ? rest.join('/') : undefined },
      props: { locale: route.locale, routeKey: route.key },
    };
  });
}

interface Props {
  locale: Locale;
  routeKey: PageKey;
}

const { locale, routeKey } = Astro.props;
---

<Base locale={locale} routeKey={routeKey}>
  <PageBody locale={locale} routeKey={routeKey} />
</Base>
