---
import Base from '../layouts/Base.astro';
import { DEFAULT_LOCALE, type Locale } from '../i18n/config';
import { href, localeSwitchLinks } from '../i18n/routes';
import { useUI } from '../i18n/ui';

/**
 * Страница 404.
 *
 * Отдаётся nginx через `error_page 404 /404.html`, а на GitHub Pages
 * работает автоматически. Помечена noindex: поисковик не должен
 * индексировать страницу ошибки.
 *
 * Пользователю предлагаем два выхода: на главную и в Telegram —
 * чаще всего человек попал сюда по устаревшей ссылке из мессенджера.
 */
const locale: Locale = DEFAULT_LOCALE;
const ui = useUI(locale);
---

<Base locale={locale} routeKey="home" noindex title="404 — Stranica nije pronađena">
  <section class="section">
    <div class="container" style="max-inline-size:40rem;text-align:center">
      <p class="eyebrow">404</p>
      <h1 class="hero__title" style="font-size:var(--fs-h1)">
        {locale === 'ru' ? 'Страница не найдена' : 'Stranica nije pronađena'}
      </h1>
      <p class="hero__lead" style="margin-inline:auto">
        {locale === 'ru'
          ? 'Возможно, ссылка устарела или в адресе опечатка.'
          : 'Moguće je da je link zastareo ili da u adresi postoji greška.'}
      </p>

      <div class="hero__actions" style="justify-content:center;margin-block-start:var(--s8)">
        <a class="btn btn--lg" href={href(locale, 'home')}>{ui.cta.back}</a>
        <a class="btn btn--ghost btn--lg" href={href(locale, 'contact')}>{ui.cta.telegram}</a>
      </div>

      <div class="lang" style="justify-content:center;margin-block-start:var(--s10)">
        {localeSwitchLinks(locale, 'home').map((link) => (
          <a class="lang__item" href={link.href}>{link.locale.toUpperCase()}</a>
        ))}
      </div>
    </div>
  </section>
</Base>
