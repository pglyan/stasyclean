---
import { LOCALE_META, DEFAULT_LOCALE, type Locale } from '../i18n/config';
import { asset, href, localeSwitchLinks, type PageKey } from '../i18n/routes';
import { getPageMeta } from '../i18n/pagemeta';
import { useUI } from '../i18n/ui';
import { site } from '../data/site';

import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import StickyCta from '../components/StickyCta.astro';
import CookieNotice from '../components/CookieNotice.astro';
import JsonLd from '../components/seo/JsonLd.astro';

/**
 * Порядок подключения стилей важен:
 *   1) tokens  — инварианты и дефолты переменных;
 *   2) params  — сквозные параметры (акцент, плотность, карточки…);
 *   3) base/layout/components — сами правила;
 *   4) @skin   — CSS выбранной темы, поэтому её палитра перекрывает дефолты.
 *
 * @skin и @theme — алиасы из astro.config.mjs. В прод-сборке они ведут на
 * файлы ОДНОЙ темы из design.config.json, в демо — на «все темы сразу»
 * (src/themes/all.css и entries/all.ts).
 */
import '../styles/tokens.css';
import '../styles/params.css';
import '../styles/base.css';
import '../styles/layout.css';
import '../styles/components-core.css';
import '../styles/components-chrome.css';
import '../styles/components-footer.css';
import '../styles/components-blocks-a.css';
import '../styles/components-blocks-b.css';
import '../styles/components-blocks-c.css';
import '../styles/components-blocks-d.css';
import '../styles/components-blocks-e.css';
import '@skin';

/**
 * Данные выбранной темы для сборки: id темы и адреса субсетов её шрифтов.
 * В прод-сборке это единственная тема, в демо — сводный список всех тем,
 * чтобы панель могла предзагрузить субсет любого выбранного шрифта.
 */
import themeEntry from '@theme';
import { designForBuild } from '../data/activeDesign';

interface Props {
  locale: Locale;
  routeKey: PageKey;
  /** Без title берётся общий заголовок бренда. */
  title?: string;
  description?: string;
  /** true для служебных страниц (404, демо-библиотека блоков). */
  noindex?: boolean;
  /** Основная сущность страницы для JSON-LD. */
  jsonLd?: Record<string, unknown>[];
}

const {
  locale,
  routeKey,
  title,
  description,
  noindex = false,
  jsonLd = [],
} = Astro.props;

const meta = LOCALE_META[locale];
const ui = useUI(locale);

/**
 * Заголовок и описание страницы.
 *
 * Раньше все внутренние страницы отдавали общий заголовок бренда — это
 * и плохой SEO-сигнал, и непонятная выдача в поиске. Теперь заголовок
 * собирается под конкретную страницу (см. src/i18n/pagemeta.ts),
 * а вызвавшая страница может передать своё значение напрямую.
 */
const pageMeta = getPageMeta(locale, routeKey);
const pageTitle = title ?? pageMeta.title;
const pageDescription = description ?? pageMeta.description;

/**
 * Абсолютные адреса для canonical и hreflang.
 *
 * Берём origin из конфига (import.meta.env.SITE) — это надёжнее, чем
 * Astro.site, и одинаково работает на пререндере и в dev-режиме.
 * href() уже учитывает base, поэтому демо-сборка на GitHub Pages
 * отдаёт корректные адреса внутри подпапки /stasyclean/.
 */
const origin = import.meta.env.SITE || `https://${site.domain}`;
const absolute = (value: string) => new URL(value, origin).href;
const canonical = absolute(href(locale, routeKey));

const alternates = localeSwitchLinks(locale, routeKey).map((link) => ({
  hreflang: LOCALE_META[link.locale].htmlLang,
  href: absolute(link.href),
}));

/**
 * Предзагружаем РОВНО ОДИН файл — субсет шрифта заголовков, соответствующий
 * алфавиту локали. Заголовок почти всегда является элементом LCP, поэтому
 * один предзагруженный файл ускоряет первую отрисовку и не конкурирует
 * за канал с остальными ресурсами. Остальные субсеты подтянутся сами,
 * когда браузер встретит их символы.
 *
 * Адреса берутся у выбранной темы (алиас @theme) и только для того
 * семейства, которое реально используется: тема без веб-шрифтов не
 * предзагружает ничего.
 */
const themeFontUrls = themeEntry.fonts[designForBuild.headingFont];
const preloadFont = themeFontUrls?.[locale];

/**
 * Цвет интерфейса браузера (адресная строка на телефоне) — акцент темы,
 * а не константа: он должен совпадать с тем, что видит посетитель.
 *
 * У темы две схемы, и у каждой свой акцент: `swatch` описывает натуральную
 * (её `kind`), `swatchAlt` — вариацию. Панель в демо обновляет мету сама
 * (syncThemeColor), здесь — значение для сборки.
 *
 * Обращаемся к designForBuild напрямую, а не через локальный `theme`:
 * Astro поднимает объявления, которые нужны шаблону, наверх тела компонента,
 * и ссылка на `theme` оказалась бы выше его объявления.
 */
const themeColor =
  designForBuild.scheme === designForBuild.theme.kind
    ? designForBuild.theme.swatch[1]
    : designForBuild.theme.swatchAlt[1];

/**
 * Пока в проекте нет фотографий, вместо og:image используется
 * сгенерированная на сборке картинка (scripts/make-og.mjs).
 *
 * Путь собираем через asset(): склейка `${import.meta.env.BASE_URL}og/...`
 * в демо-сборке давала '/stasycleanog/sr.png' — base приходит без слэша.
 */
const ogImage = absolute(asset(`og/${locale}.png`));

const demoMode = import.meta.env.PUBLIC_DEMO === 'on';

/** Тема, выбранная на сборке: её CSS, её палитра, её умолчания. */
const theme = designForBuild.theme;

/**
 * Алиас @theme и design.config.json обязаны указывать на одну тему:
 * первый выбирает CSS, второй — значения параметров. В демо алиас ведёт на
 * сводный вход (id 'all'), потому что там тема меняется прямо в браузере.
 */
if (!demoMode && themeEntry.id !== theme.id) {
  throw new Error(
    `Расхождение темы: astro.config.mjs выбрал «${themeEntry.id}», ` +
      `а design.config.json — «${theme.id}». ` +
      'Пересоберите конфиг командой npm run design или проверьте алиас @theme.',
  );
}

/**
 * Тема обязана поставлять все семейства, которые сама разрешает в поле
 * `available` (src/data/themes.ts). Иначе предзагрузка шрифта останется
 * без адреса, а браузер молча возьмёт fallback — и заказчик увидит не тот
 * шрифт, который выбирал в панели. Дешевле упасть на сборке.
 */
const missingFonts = [...new Set([...theme.available.heading, ...theme.available.body])].filter(
  (kind) => kind !== 'system' && !themeEntry.fonts[kind],
);

if (missingFonts.length) {
  throw new Error(
    `Тема «${theme.id}» разрешает шрифты ${missingFonts.join(', ')}, но её вход ` +
      `(src/themes/entries/${theme.id}.ts) их не поставляет. Добавьте туда импорт ` +
      'адресов субсетов или уберите семейство из `available`.',
  );
}

const DemoPanel = demoMode
  ? (await import('../components/demo/DemoPanel.astro')).default
  : null;
---

<!doctype html>
<html
  lang={meta.htmlLang}
  {...designForBuild.attributes}
  style={designForBuild.style || undefined}
>
  <head>
    <meta charset="utf-8" />
    {/* viewport-fit=cover включает переменные safe-area (вырез камеры,
        скруглённые углы). Без него на iPhone в ландшафте контент уходит под
        вырез, а отступ под индикатор «домой» в закреплённой панели действий
        становится нулевым. Сами отступы — в base.css и components-footer.css. */}
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />

    {/*
      Раннее восстановление схемы.

      На сборке data-scheme приходит из design.config.json (activeDesign.ts),
      а выбор посетителя лежит в localStorage. Считать его в конце разбора
      страницы поздно: у вернувшегося посетителя страница успела бы мигнуть
      светлой темой из конфига. Поэтому крошечный inline-скрипт — без
      импортов и без модуля, он обязан выполниться до первой отрисовки.
      Ключ тот же, что у общего механизма схемы (src/scripts/scheme.ts).

      Скрипт один на все страницы и в прод, и в демо: в демо панель затем
      применяет поверх своё сохранённое состояние.
    */}
    <script is:inline>
      try {
        const savedScheme = localStorage.getItem('stasyclean:scheme');
        if (savedScheme === 'light' || savedScheme === 'dark') {
          document.documentElement.dataset.scheme = savedScheme;
        }
      } catch {
        /* приватный режим: остаётся схема из design.config.json */
      }
    </script>

    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={canonical} />

    {noindex && <meta name="robots" content="noindex, nofollow" />}

    {/* Языковые альтернативы. x-default ведёт на язык по умолчанию. */}
    {alternates.map((alternate) => (
      <link rel="alternate" hreflang={alternate.hreflang} href={alternate.href} />
    ))}
    <link rel="alternate" hreflang="x-default" href={absolute(href(DEFAULT_LOCALE, routeKey))} />

    {/* Open Graph */}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.brand} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={meta.ogLocale} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    {localeSwitchLinks(locale, routeKey)
      .filter((link) => !link.isCurrent)
      .map((link) => (
        <meta property="og:locale:alternate" content={LOCALE_META[link.locale].ogLocale} />
      ))}

    <meta name="twitter:card" content="summary_large_image" />

    {/* Иконки и манифест */}
    <link rel="icon" href={asset('favicon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={asset('favicon.svg')} />
    <link rel="manifest" href={asset('manifest.webmanifest')} />
    <meta name="theme-color" content={themeColor} />

    {/* Один предзагруженный файл шрифта: субсет заголовков для этой локали.
        Тема без веб-шрифтов (headingFont = system) не предзагружает ничего. */}
    {preloadFont && (
      <link rel="preload" href={preloadFont} as="font" type="font/woff2" crossorigin />
    )}

    <JsonLd locale={locale} routeKey={routeKey} extra={jsonLd} />
  </head>

  <body>
    <a class="skip-link" href="#main">{ui.cta.menu === 'Menu' ? 'Skip to content' : 'К содержанию'}</a>

    <Header locale={locale} routeKey={routeKey} />

    <main id="main" tabindex="-1">
      <slot />
    </main>

    <Footer locale={locale} />
    <StickyCta locale={locale} />
    <CookieNotice locale={locale} />

    {DemoPanel && <DemoPanel locale={locale} />}
  </body>
</html>
