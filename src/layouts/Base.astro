---
import { LOCALE_META, DEFAULT_LOCALE, LOCALES, type Locale } from '../i18n/config';
import { asset, href, localeSwitchLinks, type PageKey } from '../i18n/routes';
import { getPageMeta } from '../i18n/pagemeta';
import { useUI } from '../i18n/ui';
import { site } from '../data/site';
import { SCHEME_KEY } from '../scripts/keys';

import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import StickyCta from '../components/StickyCta.astro';
import CookieNotice from '../components/CookieNotice.astro';
import JsonLd from '../components/seo/JsonLd.astro';

/**
 * Порядок подключения стилей важен:
 *   1) tokens  — переменные: инварианты и параметры стиля;
 *   2) base/layout/components — сами правила;
 *   3) @skin   — CSS темы, поэтому её палитра перекрывает дефолты.
 *
 * @skin — алиас из astro.config.mjs: он указывает на CSS темы сайта
 * (src/themes/nordic/theme.css).
 */
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/layout.css';
import '../styles/components-core.css';
import '../styles/components-chrome.css';
import '../styles/components-footer.css';
import '../styles/components-blocks-a.css';
import '../styles/components-blocks-b.css';
import '../styles/components-blocks-c.css';
import '../styles/components-blocks-d.css';
import '../styles/components-blocks-e.css';
import '@skin';

/**
 * Оформление сайта для сборки: схема, шрифты, цвета, атрибуты <html>
 * (src/theme.ts).
 */
import { defaultScheme, headingFont, bodyFont, fontUrls, htmlAttributes } from '../theme';
import { accentHex } from '../themes/brand';

interface Props {
  locale: Locale;
  routeKey: PageKey;
  /** Без title берётся общий заголовок бренда. */
  title?: string;
  description?: string;
  /** true для служебных страниц (404). */
  noindex?: boolean;
  /** Основная сущность страницы для JSON-LD. */
  jsonLd?: Record<string, unknown>[];
}

const { locale, routeKey, title, description, noindex = false, jsonLd = [] } = Astro.props;

const meta = LOCALE_META[locale];
const ui = useUI(locale);

/**
 * Заголовок и описание страницы.
 *
 * Раньше все внутренние страницы отдавали общий заголовок бренда — это
 * и плохой SEO-сигнал, и непонятная выдача в поиске. Теперь заголовок
 * собирается под конкретную страницу (см. src/i18n/pagemeta.ts),
 * а вызвавшая страница может передать своё значение напрямую.
 */
const pageMeta = getPageMeta(locale, routeKey);
const pageTitle = title ?? pageMeta.title;
// Служебная страница (404) не наследует description главной — она noindex.
const pageDescription = description ?? (noindex ? '' : pageMeta.description);

/**
 * Абсолютные адреса для canonical и hreflang.
 *
 * Берём origin из конфига (import.meta.env.SITE) — это надёжнее, чем
 * Astro.site, и одинаково работает на пререндере и в dev-режиме.
 * href() уже учитывает base, поэтому адреса всегда собраны правильно.
 */
const origin = import.meta.env.SITE || `https://${site.domain}`;
const absolute = (value: string) => new URL(value, origin).href;
const canonical = absolute(href(locale, routeKey));

const alternates = localeSwitchLinks(locale, routeKey).map((link) => ({
  hreflang: LOCALE_META[link.locale].htmlLang,
  href: absolute(link.href),
}));

/**
 * Список файлов шрифта для предзагрузки: оба семейства (заголовки + текст)
 * × все их сабсеты. Порядок — по важности: текущая локаль страницы
 * (участвует в LCP), затем остальные по порядку LOCALES (sr, ru, en);
 * семейство заголовков идёт первым. Дубли схлопываются, но позиция
 * первого вхождения сохраняется.
 *
 * Полный список, а не только «нужный алфавит»: замер показал, что страницы
 * ЛЮБОЙ локали отрисовывают текст на всех трёх сабсетах — названия языков
 * в переключателе, имена и цитаты в отзывах, альты картинок. Эти файлы
 * браузер всё равно скачивает, preload лишь ставит их в начало очереди.
 *
 * Это пара к `font-display: optional` в src/fonts/*.css: предзагрузка
 * стартует на первом байте HTML (не дожидаясь CSS с @font-face) и даёт
 * шрифту шанс успеть к первой отрисовке. Если шрифт не успел — страница
 * остаётся на системном шрифте до конца визита, но НЕ меняется после
 * отрисовки: видимого «прыжка» шрифта не бывает ни при какой скорости сети.
 *
 * Тема без веб-шрифтов (шрифт = system) не предзагружает ничего.
 */
const preloadFonts = [
  ...new Set(
    [headingFont, bodyFont].flatMap((family) => {
      const familyUrls = fontUrls[family];
      return familyUrls ? [familyUrls[locale], ...LOCALES.map((code) => familyUrls[code])] : [];
    }),
  ),
];

/**
 * Цвет интерфейса браузера (адресная строка на телефоне) — акцент схемы,
 * а не константа: он должен совпадать с тем, что видит посетитель.
 */
const themeColor = accentHex(defaultScheme);

/**
 * Пока в проекте нет фотографий, вместо og:image используется
 * сгенерированная на сборке картинка (scripts/make-og.mjs).
 *
 * Путь собираем через asset(): склейка `${import.meta.env.BASE_URL}og/...`
 * учитывает base — он приходит без слэша.
 */
const ogImage = absolute(asset(`og/${locale}.png`));
---

<!doctype html>
<html lang={meta.htmlLang} {...htmlAttributes}>
  <head>
    <meta charset="utf-8" />
    {/* viewport-fit=cover включает переменные safe-area (вырез камеры,
        скруглённые углы). Без него на iPhone в ландшафте контент уходит под
        вырез, а отступ под индикатор «домой» в закреплённой панели действий
        становится нулевым. Сами отступы — в base.css и components-footer.css. */}
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />

    {/*
      Раннее восстановление схемы.

      На сборке data-scheme задаёт src/theme.ts, а выбор
      посетителя лежит в localStorage. Считать его в конце разбора
      страницы поздно: у вернувшегося посетителя страница успела бы мигнуть
      несохранённой схемой. Поэтому крошечный inline-скрипт — без
      импортов и без модуля, он обязан выполниться до первой отрисовки.
      Ключ из src/scripts/keys.ts — единственного источника ключей
      хранилища; inline-скрипт не умеет импортировать, поэтому константу
      передаём сюда через define:vars.

      Если сохранённого выбора нет, следуем системной настройке
      (prefers-color-scheme): тёмную тему включают большинство телефонов
      вечером, и молча показывать им светлую страницу — лишний стресс для
      глаз. Явный выбор посетителя всегда важнее системной настройки.
    */}
    <script is:inline define:vars={{ schemeKey: SCHEME_KEY }}>
      let savedScheme = null;
      try {
        savedScheme = localStorage.getItem(schemeKey);
      } catch {
        /* приватный режим: сохранённого выбора нет */
      }
      if (savedScheme === 'light' || savedScheme === 'dark') {
        document.documentElement.dataset.scheme = savedScheme;
      } else if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
        document.documentElement.dataset.scheme = 'dark';
      }
    </script>
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />

    {noindex && <meta name="robots" content="noindex, nofollow" />}

    {/*
      Адресная разметка (canonical, hreflang, og:url, JSON-LD) — только для
      индексируемых страниц: у noindex-страницы (404) нет канонического
      адреса, а хлебные крошки и LocalBusiness к ней не относятся.
    */}
    {!noindex && (
      <>
        <link rel="canonical" href={canonical} />

        {/* Языковые альтернативы. x-default ведёт на язык по умолчанию. */}
        {alternates.map((alternate) => (
          <link rel="alternate" hreflang={alternate.hreflang} href={alternate.href} />
        ))}
        <link
          rel="alternate"
          hreflang="x-default"
          href={absolute(href(DEFAULT_LOCALE, routeKey))}
        />
      </>
    )}

    {/* Open Graph */}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.brand} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:locale" content={meta.ogLocale} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    {localeSwitchLinks(locale, routeKey)
      .filter((link) => !link.isCurrent)
      .map((link) => (
        <meta property="og:locale:alternate" content={LOCALE_META[link.locale].ogLocale} />
      ))}

    <meta name="twitter:card" content="summary_large_image" />

    {/* Иконки и манифест */}
    <link rel="icon" href={asset('favicon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={asset('favicon.svg')} />
    <link rel="manifest" href={asset('manifest.webmanifest')} />
    <meta name="theme-color" content={themeColor} />

    {/* Критичные шрифты: список и обоснование — у preloadFonts выше. */}
    {preloadFonts.map((href) => (
      <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />
    ))}

    {!noindex && <JsonLd locale={locale} routeKey={routeKey} extra={jsonLd} />}
  </head>

  <body>
    <a class="skip-link" href="#main">
      {ui.common.skipToContent}
    </a>

    <Header locale={locale} routeKey={routeKey} />

    <main id="main" tabindex="-1">
      <slot />
    </main>

    <Footer locale={locale} />
    <StickyCta locale={locale} />
    <CookieNotice locale={locale} />

    {/* Появление блоков при прокрутке: только полироль, без JS всё видимо
        (сам скрипт ставит класс .reveal и не трогает верх первого кадра). */}
    <script>
      import { initReveal } from '../scripts/reveal';

      initReveal();
    </script>
    {/*
      Переключатель схемы — в Base, а не в Header: схема общий
      ресурс страницы, и кнопка есть даже там, где шапки нет.
    */}
    <script>
      import { initScheme } from '../scripts/scheme';

      initScheme();
    </script>
  </body>
</html>
