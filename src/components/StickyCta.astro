---
import type { Locale } from '../i18n/config';
import { href } from '../i18n/routes';
import { useUI } from '../i18n/ui';
import { site } from '../data/site';

import Icon from './ui/Icon.astro';

/**
 * Закреплённая панель действий для телефона.
 *
 * На мобильных это самый важный конверсионный элемент: пользователь
 * не должен искать кнопку в футере. Скрывается на широких экранах
 * и при `data-sticky="off"` из демо-панели.
 *
 * Мобильные правила, зашитые в разметку:
 *   • высота панели — токен --sticky-h (Панель не может стать выше места,
 *     которое под неё оставлено: см. components-footer.css);
 *   • подписи короткие (ui.cta.*Short): полные формы переносились на вторую
 *     строку и растягивали бар до 87px при резерве 72px;
 *   • полный текст уходит в aria-label, короткий — префикс полного, поэтому
 *     требование WCAG 2.5.3 «Label in name» соблюдено;
 *   • подпись завёрнута в .btn__label — только блочный контейнер умеет
 *     многоточие, если подпись когда-нибудь станет длиннее.
 */

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const ui = useUI(locale);
---

<div class="sticky-cta">
  <a
    class="btn"
    href={site.telegramUrl}
    target="_blank"
    rel="noopener noreferrer"
    aria-label={ui.cta.book}
  >
    <Icon name="telegram" class="btn__icon" />
    <span class="btn__label">{ui.cta.bookShort}</span>
  </a>
  <a
    class="btn btn--ghost"
    href={`${href(locale, 'prices')}#calculator`}
    aria-label={ui.cta.calculate}
  >
    <Icon name="calculator" class="btn__icon" />
    <span class="btn__label">{ui.cta.calcShort}</span>
  </a>
</div>
