---
import type { Locale } from '../../i18n/config';
import { LOCALE_META } from '../../i18n/config';
import { href, type PageKey } from '../../i18n/routes';
import { useUI } from '../../i18n/ui';
import type { Localized } from '../../data/types';
import { themePresets } from '../../data/themes';
import { swatchOf, themeColors } from '../../themes/tokens';
import {
  accentOptions,
  buttonOptions,
  cardOptions,
  containerOptions,
  decorOptions,
  densityOptions,
  fontOptions,
  heroOptions,
  orderHintOptions,
  paletteOptions,
  photoOptions,
  photoShapeOptions,
  radiusOptions,
  sectionsOptions,
  surfaceOptions,
  textureOptions,
} from '../../data/designOptions';
import { designForBuild } from '../../data/activeDesign';

import Icon from '../ui/Icon.astro';

/**
 * Стили панели подключаем как текст и вставляем в <style> прямо в компоненте.
 * Так они появляются только на страницах, где рендерится панель (то есть
 * в демо-сборке), и не попадают ни в прод-CSS, ни в общий файл стилей.
 */
import panelCss from '../../styles/components-panel.css?raw';

/**
 * Панель демонстрационных настроек.
 *
 * Рендерится только в демо-сборке: Base.astro импортирует компонент
 * динамически под константным условием `PUBLIC_DEMO`, поэтому в прод-версию
 * ни разметка, ни скрипт панели не попадают вообще.
 *
 * Настройки применяются двумя способами:
 *   attr:data-*    — атрибут на <html> (тема, шрифты, плотность, карточки…);
 *   style:--token  — inline CSS-переменная (акцентный тон, радиус).
 * Поэтому ослабленный выбор комбинируется с любой темой, а не переопределяет её.
 *
 * Тема — это целый стиль оформления, а не палитра: у неё свои умолчания
 * (радиус, шрифты, карточки, раскладка первого экрана) и свой CSS
 * (src/themes/<id>/theme.css). При выборе темы панель подставляет её
 * умолчания — но только для тех настроек, которые заказчик не трогал вручную.
 *
 * Схема (data-scheme) — отдельная ось рядом с палитрой: у каждой темы есть
 * светлая и тёмная вариации (src/themes/<id>/scheme.css). В тёмной схеме
 * палитра не предлагается, поэтому группа «Палитра» скрывается, атрибут
 * data-palette снимается, а свотч карточки темы показывается по текущей схеме
 * (applySchemeRules и paintThemeCardSwatches). Переключить схему можно и без
 * панели: кнопкой [data-scheme-switch] в шапке сайта (она есть и в прод-сборке
 * — см. src/scripts/scheme.ts) и плавающей кнопкой [data-scheme-toggle] рядом
 * с «Настройками». Применяет схему общий модуль, а панель слушает его событие
 * SCHEME_EVENT и догоняет своё состояние — иначе две кнопки разошлись бы.
 */

interface Props {
  locale: Locale;
  routeKey?: PageKey;
}

const { locale, routeKey = 'home' } = Astro.props;
const ui = useUI(locale);

/**
 * Стартовое состояние стенда — выбранный дизайн из design.config.json.
 * Заказчик открывает стенд и видит ровно то, что уедет в прод; его правки
 * живут в localStorage, а «Сбросить» возвращает именно этот исходный вариант.
 */
const baked = designForBuild;
const defaults: Record<string, string> = {
  ...baked.attributes,
  accent: baked.settings.accentHue === null ? '' : String(baked.settings.accentHue),
  radius: baked.settings.radius === null ? '' : String(baked.settings.radius),
  /**
   * Подсказка заказа хранится под ключом-настройкой (как accent/radius), а не
   * под именем атрибута: иначе подсветка выбранного варианта в панели не
   * работала бы на загрузке — syncPressed ищет значение по имени настройки.
   */
  'order-hint': baked.settings.orderHint,
  /** Итоговая схема сборки: натуральная схема темы либо выбор из конфига. */
  scheme: baked.scheme,
  /**
   * Палитра после подстановки умолчания темы; '' — «как в теме». В тёмной
   * схеме палитры нет, поэтому и здесь пусто — так стартовое состояние
   * панели совпадает с разметкой сборки.
   */
  palette: baked.scheme === 'dark' ? '' : baked.palette ?? '',
};

interface Option {
  value: string;
  label: string;
  /** Тон (H) для цветового кружка в панели. */
  hue?: number;
}

interface Group {
  label: string;
  setting: string;
  apply: string;
  options: Option[];
  /** Группу фильтруем по списку активной темы: чего тема не разрешает — не показываем. */
  filterByTheme?: 'heading' | 'body' | 'palette';
  /** Как показать вариант: точкой тона (акцент) или свотчем палитры. */
  dots?: 'palette';
}

/** Подписи вариантов локализованы — стенд смотрят на трёх языках. */
const toOptions = (options: { value: string | number; label: Localized; hue?: number }[]): Option[] =>
  options.map((option) => ({
    value: String(option.value),
    label: option.label[locale],
    hue: option.hue,
  }));

/** Группы настроек описываются данными — разметка остаётся компактной. */
const groups: Group[] = [
  {
    label: ui.panel.scheme,
    setting: 'scheme',
    apply: 'attr:data-scheme',
    /* Схема — ось поверх темы: цвета даёт CSS темы (scheme.css), параметр
       только переключает атрибут. Работает у каждой темы, потому что у всех
       есть обе схемы (натуральная — её `kind`, вариация — второй блок). */
    options: [
      { value: 'light', label: ui.panel.schemeLight },
      { value: 'dark', label: ui.panel.schemeDark },
    ],
  },
  {
    label: ui.panel.palette,
    setting: 'palette',
    apply: 'attr:data-palette',
    /* «Как в теме» — это отсутствие атрибута: тема показывает свой набор
       цветов так, как его написал автор. */
    options: [{ value: '', label: ui.panel.sameAsTheme }, ...toOptions(paletteOptions)],
    filterByTheme: 'palette',
    dots: 'palette',
  },
  {
    label: ui.panel.accent,
    setting: 'accent',
    apply: 'style:--brand-h',
    options: toOptions(accentOptions),
  },
  {
    label: ui.panel.radius,
    setting: 'radius',
    apply: 'style:--radius:px',
    options: toOptions(radiusOptions),
  },
  {
    label: ui.panel.font,
    setting: 'font',
    apply: 'attr:data-font',
    options: toOptions(fontOptions),
    filterByTheme: 'heading',
  },
  {
    label: ui.panel.bodyFont,
    setting: 'body-font',
    apply: 'attr:data-body-font',
    options: toOptions(fontOptions),
    filterByTheme: 'body',
  },
  {
    label: ui.panel.density,
    setting: 'density',
    apply: 'attr:data-density',
    options: toOptions(densityOptions),
  },
  {
    label: ui.panel.card,
    setting: 'card',
    apply: 'attr:data-card',
    options: toOptions(cardOptions),
  },
  {
    label: ui.panel.button,
    setting: 'button',
    apply: 'attr:data-button',
    options: toOptions(buttonOptions),
  },
  {
    label: ui.panel.width,
    setting: 'container',
    apply: 'attr:data-container',
    options: toOptions(containerOptions),
  },
  {
    label: ui.panel.hero,
    setting: 'hero',
    apply: 'attr:data-hero',
    options: toOptions(heroOptions),
  },
  {
    label: ui.panel.sections,
    setting: 'sections',
    apply: 'attr:data-sections',
    options: toOptions(sectionsOptions),
  },
  {
    label: ui.panel.texture,
    setting: 'texture',
    apply: 'attr:data-texture',
    options: toOptions(textureOptions),
  },
  {
    label: ui.panel.surface,
    setting: 'surface',
    apply: 'attr:data-surface',
    options: toOptions(surfaceOptions),
  },
  {
    label: ui.panel.decor,
    setting: 'decor',
    apply: 'attr:data-decor',
    options: toOptions(decorOptions),
  },
  {
    label: ui.panel.photo,
    setting: 'photo',
    apply: 'attr:data-photo',
    options: toOptions(photoOptions),
  },
  {
    label: ui.panel.photoShape,
    setting: 'photo-shape',
    apply: 'attr:data-photo-shape',
    options: [{ value: '', label: ui.panel.sameAsTheme }, ...toOptions(photoShapeOptions)],
  },
  {
    label: ui.panel.motion,
    setting: 'motion',
    apply: 'attr:data-motion',
    options: [
      { value: 'on', label: ui.panel.motionOn },
      { value: 'off', label: ui.panel.motionOff },
    ],
  },
  {
    label: ui.panel.sticky,
    setting: 'sticky',
    apply: 'attr:data-sticky',
    options: [
      { value: 'on', label: ui.panel.stickyOn },
      { value: 'off', label: ui.panel.stickyOff },
    ],
  },
  {
    label: ui.panel.orderHint,
    setting: 'order-hint',
    apply: 'attr:data-order-hint',
    options: toOptions(orderHintOptions),
  },
];
---

<style is:inline set:html={panelCss}></style>

<div class="panel-fabs">
  {/*
    Быстрый переключатель схемы: работает без открытия панели, поэтому
    требование «кнопка смены светлой/тёмной» видно сразу. Показываем ту
    схему, в которую переключимся, — иконку и подпись берёт CSS по
    data-scheme на <html>, поэтому JS состояние кнопки не дублирует.

    Это орган управления стендом (рядом с «Настройками»): такую же кнопку,
    но как функцию сайта, несёт шапка (components/ui/SchemeSwitch.astro).
  */}
  <button
    class="panel-toggle panel-toggle--scheme"
    type="button"
    data-scheme-toggle
  >
    <span class="panel-toggle__icon" data-scheme-show="dark" aria-hidden="true">
      <Icon name="moon" class="icon--sm" />
    </span>
    <span class="panel-toggle__icon" data-scheme-show="light" aria-hidden="true">
      <Icon name="sun" class="icon--sm" />
    </span>
    <span data-scheme-show="dark">{ui.panel.schemeDark}</span>
    <span data-scheme-show="light">{ui.panel.schemeLight}</span>
  </button>

  <button
    class="panel-toggle"
    type="button"
    data-panel-open
    aria-expanded="false"
    aria-controls="demo-panel"
  >
    <Icon name="sliders" class="icon--sm" />
    {ui.panel.open}
  </button>
</div>

<aside class="panel" id="demo-panel" data-panel data-defaults={JSON.stringify(defaults)} hidden>
  <div class="panel__head">
    <div>
      <h2 class="panel__title">{ui.panel.title}</h2>
      <p class="panel__subtitle">{ui.panel.subtitle}</p>
    </div>
    <button class="burger" type="button" data-panel-close aria-label={ui.cta.close}>
      <Icon name="close" width={2} />
    </button>
  </div>

  <div class="panel__body">
    <div class="panel__group">
      <span class="panel__label">{ui.panel.presets}</span>
      <div class="panel__themes">
        {themePresets.map((preset) => {
          const colors = themeColors[preset.id];
          const swatch = swatchOf(colors.base);
          const swatchAlt = swatchOf(colors.alt);
          const paletteSwatches = Object.fromEntries(
            preset.available.palettes.map((id) => [id, swatchOf(colors.palettes[id])]),
          );
          return (
          <button
            class="panel__theme"
            type="button"
            data-setting="theme"
            data-value={preset.id}
            data-apply="attr:data-skin"
            data-meta-radius={String(preset.defaults.radius)}
            data-meta-density={preset.defaults.density}
            data-meta-font={preset.defaults.headingFont}
            data-meta-body-font={preset.defaults.bodyFont}
            data-meta-card={preset.defaults.card}
            data-meta-button={preset.defaults.button}
            data-meta-container={preset.defaults.container}
            data-meta-hero={preset.defaults.hero}
            data-meta-sections={preset.defaults.sections}
            data-meta-texture={preset.defaults.texture}
            data-meta-surface={preset.defaults.surface}
            data-meta-decor={preset.defaults.decor}
            data-meta-photo={preset.defaults.photo}
            data-meta-photo-shape={preset.defaults.photoShape ?? ''}
            data-meta-heading={preset.available.heading.join(',')}
            data-meta-body={preset.available.body.join(',')}
            data-meta-scheme={preset.kind}
            data-meta-swatch={JSON.stringify(swatch)}
            data-meta-swatch-alt={JSON.stringify(swatchAlt)}
            data-meta-color={swatch[1]}
            data-meta-color-dark={swatchAlt[1]}
            data-meta-palette={preset.defaults.palette ?? ''}
            data-meta-palettes={JSON.stringify(paletteSwatches)}
            data-kind={preset.kind}
            title={preset.description[locale]}
          >
            <span class="panel__theme-swatch" aria-hidden="true">
              {swatch.map((color) => (
                <span data-theme-swatch style={`background:${color}`}></span>
              ))}
            </span>
            <span class="panel__theme-name">{preset.name[locale]}</span>
          </button>
          );
        })}
      </div>
    </div>

    {groups.map((group) => (
      <div class="panel__group">
        <span class="panel__label">{group.label}</span>
        <div class="panel__options" data-filter={group.filterByTheme}>
          {group.options.map((option) => (
            <button
              class="panel__option"
              type="button"
              data-setting={group.setting}
              data-value={option.value}
              data-apply={group.apply}
            >
              {group.dots === 'palette' && (
                <span class="panel__option-swatch" aria-hidden="true">
                  <span data-swatch></span>
                  <span data-swatch></span>
                  <span data-swatch></span>
                </span>
              )}
              {option.hue !== undefined && (
                <span
                  aria-hidden="true"
                  style={`display:inline-block;inline-size:.7em;block-size:.7em;border-radius:50%;margin-inline-end:.4em;background:hsl(${option.hue} 72% 40%)`}
                ></span>
              )}
              {option.label}
            </button>
          ))}
        </div>
      </div>
    ))}

    <div class="panel__group">
      <span class="panel__label">{ui.panel.language}</span>
      <div class="panel__options">
        {Object.values(LOCALE_META).map((item) => (
          <a
            class="panel__option"
            href={href(item.code, routeKey)}
            aria-current={item.code === locale ? 'true' : undefined}
          >
            {item.label}
          </a>
        ))}
      </div>
    </div>
  </div>

  <div class="panel__foot">
    <button class="btn btn--sm" type="button" data-panel-export>
      <Icon name="copy" class="btn__icon" />
      {ui.panel.export}
    </button>
    <button class="btn btn--ghost btn--sm" type="button" data-panel-random>
      <Icon name="dice" class="btn__icon" />
      {ui.panel.random}
    </button>
    <button class="btn btn--ghost btn--sm" type="button" data-panel-reset>
      <Icon name="refresh" class="btn__icon" />
      {ui.panel.reset}
    </button>
    <p class="panel__toast" data-panel-toast role="status">{ui.panel.exported}</p>
    <p class="panel__notice">{ui.panel.notice}</p>
  </div>
</aside>


<script>
  /**
   * Логика демо-панели.
   *
   * Любая настройка — это либо атрибут на <html>, либо inline CSS-переменная.
   * Никаких перерисовок: браузер сам пересчитывает стили, поэтому смена темы
   * мгновенная. Состояние живёт в localStorage, поэтому выбор заказчика
   * сохраняется между страницами и перезагрузками.
   *
   * Ссылка с ?panel=0 открывается без кнопки панели — удобно, когда нужно
   * отправить заказчику «чистый» вид без настроек.
   */
  import { SCHEME_EVENT, applyScheme, asScheme, type Scheme } from '../../scripts/scheme';

  const root = document.documentElement;
  const panel = document.querySelector<HTMLElement>('[data-panel]');
  const openBtn = document.querySelector<HTMLButtonElement>('[data-panel-open]');
  const schemeToggle = document.querySelector<HTMLButtonElement>('[data-scheme-toggle]');
  const closeBtn = document.querySelector<HTMLButtonElement>('[data-panel-close]');
  const toast = document.querySelector<HTMLElement>('[data-panel-toast]');

  /**
   * Ключ хранилища версионирован: до перехода на темы-скины в нём лежали
   * другие значения (data-theme='mint'), а в версии 3 изменилось фото:
   * лечение снимка (data-photo) и его форма (data-photo-shape) разделились,
   * поэтому старое значение photo='arch' больше ничего не значит и такие
   * записи нужно игнорировать, а не применять. В версии 4 появилась схема
   * (data-scheme): в старых записях её нет, поэтому выбор пересоберётся из
   * умолчаний темы — это надёжнее, чем «дотягивать» чужое значение.
   */
  const STORAGE_VERSION = 4;
  const STORAGE_KEY = 'stasyclean:demo:v2';
  const defaults: Record<string, string> = JSON.parse(panel?.dataset.defaults ?? '{}');

  if (new URLSearchParams(window.location.search).get('panel') === '0') {
    openBtn?.remove();
    // ?panel=0 — «чистый» вид: убираем весь блок кнопок стенда. Кнопка схемы
    // в шапке сайта при этом остаётся: это функция сайта, а не стенда.
    document.querySelector('.panel-fabs')?.remove();
  }

  /** Карта «настройка → как её применить», берётся прямо из разметки. */
  const APPLY: Record<string, string> = {};
  document.querySelectorAll<HTMLElement>('[data-setting]').forEach((element) => {
    const setting = element.dataset.setting;
    if (setting && element.dataset.apply) APPLY[setting] = element.dataset.apply;
  });

  /** Настройки, заданные вручную: тема их не перезаписывает. */
  let touched: string[] = [];
  let settings: Record<string, string> = { ...defaults };

  function applyOne(setting: string, value: string) {
    const rule = APPLY[setting];
    if (!rule) return;

    /**
     * Схема применяется общим механизмом сайта (src/scripts/scheme.ts), а не
     * здесь: тот же переключатель есть в шапке, и две отдельные реализации
     * разошлись бы после первого же клика. Модуль сам ставит атрибут,
     * обновляет мету, помнит выбор и сообщает о смене событием.
     */
    if (setting === 'scheme') {
      applyScheme(asScheme(value) ?? 'light');
      return;
    }

    if (rule.startsWith('attr:')) {
      const attribute = rule.slice(5);
      if (value) root.setAttribute(attribute, value);
      else root.removeAttribute(attribute);
      return;
    }

    const [variable, unit = ''] = rule.slice(6).split(':');
    if (value) root.style.setProperty(variable, unit ? `${value}${unit}` : value);
    else root.style.removeProperty(variable);
  }

  function syncPressed() {
    document.querySelectorAll<HTMLElement>('[data-setting]').forEach((element) => {
      element.setAttribute(
        'aria-pressed',
        String(settings[element.dataset.setting ?? ''] === element.dataset.value),
      );
    });
  }

  function save() {
    try {
      window.localStorage.setItem(
        STORAGE_KEY,
        JSON.stringify({ version: STORAGE_VERSION, settings, touched }),
      );
    } catch {
      /* приватный режим — просто не сохраняем */
    }
  }

  /**
   * Умолчания темы: ключи совпадают с именами настроек, значения приходят
   * из data-meta-* на кнопке темы.
   */
  const THEME_DEFAULT_KEYS: Record<string, string> = {
    scheme: 'metaScheme',
    palette: 'metaPalette',
    radius: 'metaRadius',
    density: 'metaDensity',
    font: 'metaFont',
    'body-font': 'metaBodyFont',
    card: 'metaCard',
    button: 'metaButton',
    container: 'metaContainer',
    hero: 'metaHero',
    sections: 'metaSections',
    texture: 'metaTexture',
    surface: 'metaSurface',
    decor: 'metaDecor',
    photo: 'metaPhoto',
    'photo-shape': 'metaPhotoShape',
  };

  /**
   * Показываем только то, что тема действительно везёт: шрифты — из её
   * available, палитры — из available.palettes.
   *
   * Это не косметика: в прод-сборку попадают файлы шрифтов и CSS палитр
   * только выбранной темы. Если бы заказчик выбрал «Nunito» внутри темы без
   * Nunito или палитру, которой у темы нет, после сборки он увидел бы другое
   * оформление и не понял, почему. Если тема не разрешает ни одного варианта —
   * прячем группу целиком, а не показываем пустой ряд.
   */
  function syncThemeOptions(themeButton: HTMLElement) {
    const allowed: Record<string, string[]> = {
      heading: (themeButton.dataset.metaHeading ?? '').split(','),
      body: (themeButton.dataset.metaBody ?? '').split(','),
      palette: Object.keys(palettesOf(themeButton)),
    };

    /**
     * В тёмной схеме палитры не предлагаются: цвета даёт сама вариация схемы
     * (scheme.css), поэтому палитра и схема не спорят за одни переменные.
     */
    const darkScheme = settings.scheme === 'dark';

    document.querySelectorAll<HTMLElement>('[data-filter]').forEach((list) => {
      const filter = list.dataset.filter ?? '';
      const allow = allowed[filter] ?? [];
      let visible = 0;

      list.querySelectorAll<HTMLElement>('[data-setting]').forEach((option) => {
        const value = option.dataset.value ?? '';
        // «Как в теме» (пустое значение) имеет смысл, только если есть из чего выбирать
        option.hidden =
          (darkScheme && filter === 'palette') ||
          allow.length === 0 ||
          (value !== '' && !allow.includes(value));
        if (!option.hidden) visible += 1;
      });

      list.closest('.panel__group')?.toggleAttribute('hidden', visible === 0);
    });

    paintPaletteSwatches(themeButton);
    paintThemeCardSwatches(themeButton);
  }

  /** Свотчи палитр берём у темы: одна и та же палитра в разных темах своя. */
  function palettesOf(themeButton: HTMLElement): Record<string, string[]> {
    try {
      return JSON.parse(themeButton.dataset.metaPalettes ?? '{}');
    } catch {
      return {};
    }
  }

  function paintPaletteSwatches(themeButton: HTMLElement) {
    const palettes = palettesOf(themeButton);

    document.querySelectorAll<HTMLElement>('[data-setting="palette"]').forEach((option) => {
      const swatch = palettes[option.dataset.value ?? ''];
      option.querySelectorAll<HTMLElement>('[data-swatch]').forEach((dot, index) => {
        dot.style.background = swatch ? swatch[index] : '';
      });
    });
  }

  /**
   * Свотч в карточке темы показывает ТЕКУЩУЮ схему: у светлых тем по
   * умолчанию светлый набор, у nordic — тёмный. Когда заказчик переключает
   * схему, карточка перекрашивается, поэтому паспорт темы не врёт.
   */
  function paintThemeCardSwatches(themeButton: HTMLElement) {
    const natural = themeButton.dataset.metaScheme === settings.scheme;
    const raw = natural ? themeButton.dataset.metaSwatch : themeButton.dataset.metaSwatchAlt;

    let colors: string[] = [];
    try {
      colors = JSON.parse(raw ?? '[]') as string[];
    } catch {
      colors = [];
    }

    themeButton.querySelectorAll<HTMLElement>('[data-theme-swatch]').forEach((dot, index) => {
      dot.style.background = colors[index] ?? '';
    });
  }

  /** Подставляет умолчания темы — но только то, что заказчик не трогал. */
  function applyThemeDefaults(themeButton: HTMLElement) {
    for (const [setting, key] of Object.entries(THEME_DEFAULT_KEYS)) {
      if (touched.includes(setting)) continue;

      /**
       * Пустое значение — это тоже умолчание: так помечены «палитра как в
       * теме» и «форма фото как в базовом слое». Пропустить его нельзя,
       * иначе после темы с палитрой у следующей темы остался бы её атрибут.
       */
      const value = themeButton.dataset[key];
      if (value === undefined) continue;

      settings[setting] = value;
      applyOne(setting, value);
    }

    syncThemeOptions(themeButton);
  }

  /**
   * Цвет адресной строки браузера на стенде — как у собранной темы.
   *
   * На сборке <meta name="theme-color"> приходит из палитры выбранной темы
   * (Base.astro), а в демо тема и палитра меняются в браузере, поэтому панель
   * обновляет мету сама: заказчик видит на телефоне тот же акцент. Если
   * выбрана палитра — берём её акцент, иначе акцент темы.
   */
  function syncThemeColor(themeButton: HTMLElement) {
    const meta = document.querySelector<HTMLMetaElement>('meta[name="theme-color"]');

    /** Палитра есть только в светлой схеме; её акцент важнее акцента темы. */
    const paletteAccent = palettesOf(themeButton)[settings.palette ?? '']?.[1];
    const schemeAccent =
      settings.scheme === themeButton.dataset.metaScheme
        ? themeButton.dataset.metaColor
        : themeButton.dataset.metaColorDark;

    const color = paletteAccent ?? schemeAccent;
    if (meta && color) meta.content = color;
  }

  /**
   * Сводит две цветовые оси вместе: выбор схемы и выбор палитры.
   *
   * Схема — ось поверх темы: в тёмной схеме палитры не предлагаются, значит
   * её надо снять (иначе data-palette остался бы висеть, хотя группа скрыта).
   * При возврате к светлой — подставляем палитру темы, но только если
   * заказчик не выбирал свою: ручной выбор приоритетнее.
   */
  function applySchemeRules(themeButton: HTMLElement) {
    if (settings.scheme === 'dark') {
      settings.palette = '';
      applyOne('palette', '');
    } else if (!touched.includes('palette')) {
      const palette = themeButton.dataset.metaPalette ?? '';
      settings.palette = palette;
      applyOne('palette', palette);
    }

    syncThemeOptions(themeButton);
    syncThemeColor(themeButton);
    syncPressed();
  }

  function themeButtonOf(themeId: string) {
    return document.querySelector<HTMLElement>(`[data-setting="theme"][data-value="${themeId}"]`);
  }

  function set(setting: string, value: string) {
    settings[setting] = value;
    applyOne(setting, value);

    if (setting === 'theme') {
      // тема приносит свои умолчания (в т.ч. натуральную схему)...
      const themeButton = themeButtonOf(value);
      if (themeButton) {
        applyThemeDefaults(themeButton);
        // ...и правила сочетания осей: схема темы может снять палитру.
        applySchemeRules(themeButton);
      }
    } else {
      // ...но ручной выбор пользователя всегда приоритетнее
      if (!touched.includes(setting)) touched.push(setting);

      const themeButton = themeButtonOf(settings.theme ?? '');

      // палитра меняет ещё и акцент в адресной строке браузера
      if (setting === 'palette' && themeButton) syncThemeColor(themeButton);

      // схема управляет ещё и доступностью палитры
      if (setting === 'scheme' && themeButton) applySchemeRules(themeButton);
    }

    syncPressed();
    save();
  }

  document.querySelectorAll<HTMLElement>('[data-setting]').forEach((element) => {
    element.addEventListener('click', () => {
      set(element.dataset.setting ?? '', element.dataset.value ?? '');
    });
  });

  /**
   * Быстрый переключатель схемы в углу стенда: то же, что выбрать
   * «Светлая / Тёмная» в панели, но одним кликом и без её открытия. Идёт
   * через set(), поэтому учитывает правила сочетания осей (палитра в тёмной
   * схеме) и сохраняется.
   *
   * Рядом с «Настройками» он нужен потому, что это орган управления СТЕНДОМ:
   * кнопка в шапке (SchemeSwitch.astro) — функция сайта и есть в проде,
   * а эта живёт только на страницах демо-сборки.
   */
  schemeToggle?.addEventListener('click', () => {
    set('scheme', settings.scheme === 'dark' ? 'light' : 'dark');
  });

  /**
   * Схему могли переключить кнопкой в шапке сайта — она видна и на стенде.
   * Тогда состояние панели надо догнать: иначе подсветка в группе «Схема»
   * осталась бы на прошлом значении, а палитра — скрытой или доступной
   * неправильно. Схема к <html> уже применена общим модулем, поэтому здесь
   * обновляем только состояние панели (без повторного applyOne — иначе
   * получилось бы кольцо из событий).
   */
  document.addEventListener(SCHEME_EVENT, (event) => {
    const scheme = (event as CustomEvent<{ scheme?: Scheme }>).detail?.scheme;
    if (!scheme || scheme === settings.scheme) return;

    settings.scheme = scheme;
    if (!touched.includes('scheme')) touched.push('scheme');

    const themeButton = themeButtonOf(settings.theme ?? '');
    if (themeButton) applySchemeRules(themeButton);
    else syncPressed();

    save();
  });

  function openPanel(open: boolean) {
    if (!panel) return;
    panel.hidden = false;
    panel.classList.toggle('is-open', open);
    openBtn?.setAttribute('aria-expanded', String(open));
    if (open) closeBtn?.focus();
  }

  openBtn?.addEventListener('click', () => openPanel(true));
  closeBtn?.addEventListener('click', () => openPanel(false));
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && panel?.classList.contains('is-open')) openPanel(false);
  });

  /** Возврат стенда к выбранному дизайну (design.config.json). */
  document.querySelector('[data-panel-reset]')?.addEventListener('click', () => {
    settings = { ...defaults };
    touched = [];

    // inline-переменные сначала снимаем, затем применяем сохранённые:
    // так сброс работает и когда у дизайна акцент/радиус не переопределены
    root.style.removeProperty('--brand-h');
    root.style.removeProperty('--radius');
    Object.entries(settings).forEach(([key, value]) => applyOne(key, value));

    const themeButton = themeButtonOf(settings.theme ?? '');
    if (themeButton) applySchemeRules(themeButton);

    syncPressed();
    save();
  });

  /** Случайная комбинация — помогает найти неожиданное удачное сочетание. */
  document.querySelector('[data-panel-random]')?.addEventListener('click', () => {
    const movable = ['theme', 'scheme', 'accent', 'radius', 'font', 'density', 'card', 'button', 'hero'];

    for (const setting of movable) {
      // берём только видимые варианты: набор шрифтов ограничен активной темой
      const options = Array.from(
        document.querySelectorAll<HTMLElement>(`[data-setting="${setting}"]`),
      ).filter((option) => !option.hidden);
      if (!options.length) continue;

      const chosen = options[Math.floor(Math.random() * options.length)];
      set(setting, chosen.dataset.value ?? '');
    }
  });

  /**
   * Экспорт выбора: JSON совпадает по ключам с design.config.json, поэтому
   * его можно применить как есть — `npm run design -- apply <файл>`.
   */
  document.querySelector('[data-panel-export]')?.addEventListener('click', async () => {
    const report = JSON.stringify(
      {
        theme: settings.theme,
        scheme: settings.scheme || null,
        accentHue: settings.accent ? Number(settings.accent) : null,
        radius: settings.radius ? Number(settings.radius) : null,
        headingFont: settings.font ?? null,
        bodyFont: settings['body-font'] ?? null,
        density: settings.density,
        card: settings.card,
        button: settings.button,
        container: settings.container,
        hero: settings.hero,
        sections: settings.sections,
        texture: settings.texture,
        surface: settings.surface,
        decor: settings.decor,
        photo: settings.photo,
        photoShape: settings['photo-shape'] || null,
        palette: settings.palette || null,
        motion: settings.motion,
        stickyCta: settings.sticky,
        orderHint: settings['order-hint'],
      },
      null,
      2,
    );

    try {
      await navigator.clipboard.writeText(report);
      if (toast) {
        toast.classList.add('is-visible');
        window.setTimeout(() => toast.classList.remove('is-visible'), 1800);
      }
    } catch {
      window.prompt('Настройки демо-стенда:', report);
    }
  });

  // Восстанавливаем прошлый выбор заказчика и применяем его
  try {
    const stored = window.localStorage.getItem(STORAGE_KEY);
    if (stored) {
      const parsed = JSON.parse(stored) as {
        version?: number;
        settings?: Record<string, string>;
        touched?: string[];
      };
      if (parsed.version === STORAGE_VERSION) {
        settings = { ...defaults, ...(parsed.settings ?? {}) };
        touched = parsed.touched ?? [];
      }
    }
  } catch {
    settings = { ...defaults };
  }

  Object.entries(settings).forEach(([key, value]) => applyOne(key, value));

  const currentTheme = themeButtonOf(settings.theme ?? '');
  if (currentTheme) applySchemeRules(currentTheme);

  syncPressed();
</script>

