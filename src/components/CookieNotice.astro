---
import type { Locale } from '../i18n/config';
import { href } from '../i18n/routes';
import { useUI } from '../i18n/ui';

/**
 * Баннер cookie.
 *
 * Сайт не подключает стороннюю аналитику по умолчанию, поэтому баннер
 * не показывается (нечего согласовывать). Он появляется, только если
 * включена аналитика через PUBLIC_ANALYTICS=on.
 *
 * Текст — заготовка: юридическую формулировку должен утвердить юрист
 * (в Сербии действует ZZPL, «Сл. гласник РС» 87/2018).
 */

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const ui = useUI(locale);

const shouldRender = import.meta.env.PUBLIC_ANALYTICS === 'on';
---

{shouldRender && (
  <div class="cookie" data-cookie data-visible="false" role="region" aria-label={ui.cookie.label}>
    <p>{ui.cookie.text}</p>
    <div class="cookie__actions">
      <button class="btn btn--sm" type="button" data-cookie-accept>
        {ui.cookie.accept}
      </button>
      <a class="btn btn--ghost btn--sm" href={href(locale, 'privacy')}>
        {ui.footer.privacy}
      </a>
    </div>
  </div>
)}

{shouldRender && <script>
  /**
   * Показываем баннер только если согласие ещё не сохранено.
   * Модель инстанцирования — querySelectorAll: баннер один,
   * но скрипт не зависит от того, что элемент ровно один.
   */
  import { COOKIE_CONSENT_KEY } from '../scripts/keys';

  document.querySelectorAll<HTMLElement>('[data-cookie]').forEach((banner) => {
    try {
      if (!window.localStorage.getItem(COOKIE_CONSENT_KEY)) {
        banner.dataset.visible = 'true';
      }
    } catch {
      // Приватный режим: показываем баннер, но не навязываемся
      banner.dataset.visible = 'true';
    }

    banner.querySelector('[data-cookie-accept]')?.addEventListener('click', () => {
      banner.dataset.visible = 'false';
      try {
        window.localStorage.setItem(COOKIE_CONSENT_KEY, 'accepted');
      } catch {
        /* хранилище недоступно — просто скрываем баннер */
      }
    });
  });
</script>}
