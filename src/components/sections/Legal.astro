---
import { formatDate, type Locale } from '../../i18n/config';
import { useUI } from '../../i18n/ui';
import { legalDocs, type LegalDocKey } from '../../data/legal';
import { sectionClass } from '../ui/sectionClass';

/**
 * Юридическая страница (политика конфиденциальности, условия оказания услуг).
 *
 * Тексты лежат в каталоге src/data/legal/ для трёх локалей. Это ШАБЛОНЫ:
 * их должен утвердить юрист, поэтому внизу страницы выводится дата
 * обновления и напоминание об этом.
 */

interface Props {
  locale: Locale;
  doc: LegalDocKey;
  /** Серый фон секции (чередование полос на странице). */
  surface?: boolean;
}

const { locale, doc, surface = false } = Astro.props;
const ui = useUI(locale);
const content = legalDocs[doc][locale];
---

<section class={sectionClass(surface)} id={doc}>
  <div class="container">
    <p class="legal__updated">
      {ui.common.updated}: {formatDate(content.updated, locale)}
    </p>

    <div class="legal">
      {content.sections.map((section) => (
        <>
          <h2>{section.title}</h2>
          {section.paragraphs.map((paragraph) => (
            <p>{paragraph}</p>
          ))}
          {section.list && (
            <ul>
              {section.list.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          )}
        </>
      ))}
    </div>
  </div>
</section>
