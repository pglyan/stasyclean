---
import type { Locale } from '../../i18n/config';
import { faq as allFaq } from '../../data/faq';
import { useUI } from '../../i18n/ui';

import SectionHead from './SectionHead.astro';

/**
 * FAQ на нативных <details>.
 *
 * Ни одной строки JS: браузер сам обрабатывает раскрытие,
 * клавиатуру и скринридер.
 */

interface Props {
  locale: Locale;
  withHead?: boolean;
  limit?: number;
  surface?: boolean;
}

const { locale, withHead = true, limit, surface = false } = Astro.props;
const ui = useUI(locale);

const items = allFaq.slice(0, limit ?? allFaq.length);
---

  <section class={`section ${surface ? 'section--surface' : ''}`.trim()} id="faq">
  <div class="container">
    {withHead && <SectionHead title={ui.home.faqTitle} lead={ui.home.faqLead} />}

    <div class="faq">
      {items.map((item) => (
        <details class="faq__item">
          <summary class="faq__question">{item.question[locale]}</summary>
          <div class="faq__answer">{item.answer[locale]}</div>
        </details>
      ))}
    </div>
  </div>
</section>
