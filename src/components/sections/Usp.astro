---
import type { Locale } from '../../i18n/config';
import { usps } from '../../data/steps';
import Icon from '../ui/Icon.astro';

/** Полоса ключевых отличий. Содержимое — из публичного описания клиента. */

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<div class="container">
  {/*
    section, а не div: внутри — заголовки, и без секции они болтались
    вне структуры документа. Заголовки — h2 (не h3): после h1 первого
    экрана это следующий уровень, и пропуск уровня больше не возникает.
    Корневой элемент остаётся div-контейнером намеренно: секция-ребёнок
    не участвует в подсчёте полос (main > .section в layout.css).
  */}
  <section class="usp grid--auto">
    {usps.map((item) => (
      <div class="usp__item" data-reveal>
        <span class="icon-box">
          <Icon name={item.icon} />
        </span>
        <h2 class="usp__title">{item.title[locale]}</h2>
        <p class="usp__text">{item.text[locale]}</p>
      </div>
    ))}
  </section>
</div>
