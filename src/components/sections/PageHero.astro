---
import type { Locale } from '../../i18n/config';
import { href, type PageKey } from '../../i18n/routes';
import { useUI } from '../../i18n/ui';

import Photo from '../ui/Photo.astro';

/**
 * Компактный заголовок внутренней страницы.
 *
 * На главной роль первого экрана выполняет Hero, а внутренним страницам
 * нужен короткий «шапка + хлебные крошки»: пользователь должен понимать,
 * где он, и уметь вернуться. Крошки дублируются в JSON-LD (BreadcrumbList),
 * поэтому поисковик видит ту же иерархию.
 */

interface Props {
  locale: Locale;
  routeKey: PageKey;
  title: string;
  lead?: string;
  /** Родительская страница для крошек — только разделы навигации. */
  parentKey?: 'home' | 'prices' | 'services' | 'about' | 'reviews' | 'faq' | 'contact';
  /** Подпись для фото-слота; без неё блок фото не выводится. */
  photoHint?: string;
}

const { locale, title, lead, parentKey, photoHint } = Astro.props;
const ui = useUI(locale);
---

<section class="hero hero--page">
  <div class="container hero__inner">
    <div>
      <nav class="crumbs" aria-label={ui.common.breadcrumb}>
        <ol class="crumbs__list">
          <li>
            <a href={href(locale, 'home')}>{ui.nav.home}</a>
          </li>
          {parentKey && (
            <>
              <li aria-hidden="true">/</li>
              <li>
                <a href={href(locale, parentKey)}>{ui.nav[parentKey]}</a>
              </li>
            </>
          )}
          <li aria-hidden="true">/</li>
          <li aria-current="page">{title}</li>
        </ol>
      </nav>

      <h1 class="hero__title">{title}</h1>
      {lead && <p class="hero__lead">{lead}</p>}
    </div>

    {photoHint && (
      <div class="hero__media">
        <Photo alt={title} hint={photoHint} ratio="4 / 3" priority />
      </div>
    )}
  </div>
</section>
