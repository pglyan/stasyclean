---
import { unitLabels, type PriceLine } from '../../data/extras';
import { formatPrice, formatPriceRange, type Locale } from '../../i18n/config';
import { formatPriceFrom } from '../../i18n/ui';

import SectionHead from './SectionHead.astro';
import Section from '../ui/Section.astro';

/**
 * Список позиций прайса: дополнительные услуги и мойка окон.
 *
 * Одна цена, диапазон («1 500 – 3 000 RSD») и «от» — все три случая
 * форматируются через Intl на этапе сборки, поэтому в разметку попадает
 * уже готовый текст: в клиентский JS форматирование не уезжает.
 */

interface Props {
  locale: Locale;
  title: string;
  lead?: string;
  lines: PriceLine[];
  id?: string;
  /** Серый фон секции — чтобы соседние прайс-блоки визуально не слипались. */
  surface?: boolean;
  withHead?: boolean;
}

const { locale, title, lead, lines, id, surface = false, withHead = true } = Astro.props;
---

<Section surface={surface} id={id}>
  {withHead && <SectionHead title={title} lead={lead} />}

  <div class="price-list">
    {lines.map((line) => (
      <div class="price-row">
        <span class="price-row__name">
          {line.name[locale]}
          {unitLabels[line.unit][locale] && (
            <span class="price-row__unit"> · {unitLabels[line.unit][locale]}</span>
          )}
        </span>
        <span class="price-row__value price-row__value--num num">
          {line.price !== undefined && formatPrice(line.price, locale)}
          {line.price === undefined &&
            line.priceFrom !== undefined &&
            line.priceTo !== undefined &&
            formatPriceRange(line.priceFrom, line.priceTo, locale)}
          {line.price === undefined &&
            line.priceFrom !== undefined &&
            line.priceTo === undefined &&
            formatPriceFrom(line.priceFrom, locale)}
        </span>
      </div>
    ))}
  </div>
</Section>
