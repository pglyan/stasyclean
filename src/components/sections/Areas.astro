---
import type { Locale } from '../../i18n/config';
import { useUI } from '../../i18n/ui';
import { site } from '../../data/site';

import Icon from '../ui/Icon.astro';
import SectionHead from './SectionHead.astro';
import Section from '../ui/Section.astro';

/**
 * География работы.
 *
 * Список районов выведен данными (src/data/site.ts) — клиенту нужно
 * только подтвердить или поправить его. Это ещё и локальный SEO-сигнал:
 * поисковик видит названия општин текстом.
 */

interface Props {
  locale: Locale;
  withHead?: boolean;
  /** Серый фон секции (чередование полос на странице). */
  surface?: boolean;
}

const { locale, withHead = true, surface = false } = Astro.props;
const ui = useUI(locale);
---

<Section surface={surface} id="areas">
  {withHead && <SectionHead title={ui.home.areasTitle} lead={ui.home.areasLead} />}

  <ul class="areas list-reset">
    {site.districts.map((district) => (
      <li class="panel panel--pill small muted">{district}</li>
    ))}
  </ul>

  <p class="small muted areas__note">
    <Icon name="info" class="icon--sm" />
    {ui.home.areasNote}
  </p>
</Section>
