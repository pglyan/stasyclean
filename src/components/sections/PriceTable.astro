---
import { AREA_TIERS, areaOver, areaUnit, areaUpTo, plans } from '../../data/prices';
import { getService } from '../../data/services';
import { SERVICE_KEYS } from '../../i18n/routes';
import { formatNumber, formatPrice, type Locale } from '../../i18n/config';
import { useUI } from '../../i18n/ui';

import SectionHead from './SectionHead.astro';

/**
 * Прайс по площади.
 *
 * Таблица собрана из данных, а не написана руками: строки — диапазоны
 * площади, колонки — тарифы. Так цены на главной и на странице «Цены»
 * физически не могут разойтись.
 *
 * На телефоне таблица прокручивается по горизонтали внутри своего
 * контейнера (overflow-x), поэтому страница вбок не уезжает.
 */

interface Props {
  locale: Locale;
  withHead?: boolean;
}

const { locale, withHead = true } = Astro.props;
const ui = useUI(locale);

/** Только тарифы, которые считаются по метражу. */
const groups = SERVICE_KEYS.map((key) => ({
  service: getService(key),
  plans: plans.filter((plan) => plan.serviceKey === key),
})).filter((group) => group.plans.length > 0 && group.service.priceUnit === 'area');

/**
 * Колонки таблицы — тариф ВМЕСТЕ со своей услугой.
 *
 * Услуга нужна не самой таблице, а её виду на телефоне: там заголовки
 * столбцов переезжают в data-label (см. components-blocks-b.css), и без
 * названия услуги строка «Стандарт» рядом с «Премиум» из другой услуги
 * перестала бы быть понятной.
 */
const columns = groups.flatMap((group) =>
  group.plans.map((plan) => ({ plan, service: group.service })),
);

/** Подписи столбцов для мобильных карточек (см. components-blocks-b.css). */
const columnLabel = (column: (typeof columns)[number]) => planLabel(column.plan, column.service);

/**
 * Подпись строки в мобильной карточке.
 *
 * На телефоне карточка — это диапазон площади, а внутри неё строки тарифов;
 * подпись подставляется в каждую ячейку через data-label (::before), поэтому
 * она повторяется на странице десятки раз и за её длиной стоит вес страницы.
 *
 * Название услуги добавляем только там, где без него тариф не опознать:
 *   • «Стандарт» есть и в поддерживающей уборке, и в генеральной — тут
 *     название услуги обязательно;
 *   • «Премиум. Всё включено» в прайсе одно — хватает названия тарифа;
 *   • «Уборка после ремонта · После ремонта» — тавтология, оставляем второе.
 */
function planLabel(plan: (typeof plans)[number], service: (typeof columns)[number]['service']) {
  const name = plan.name[locale];
  const serviceName = service.name[locale];

  const collidesWithAnotherPlan = columns.some(
    (column) => column.plan.id !== plan.id && column.plan.name[locale] === name,
  );
  const repeatsServiceName = serviceName.toLowerCase().includes(name.toLowerCase());

  return collidesWithAnotherPlan && !repeatsServiceName ? `${serviceName} · ${name}` : name;
}
---

<section class="section section--surface" id="prices">
  <div class="container">
    {withHead && (
      <SectionHead title={ui.home.pricesTitle} lead={ui.home.pricesLead} />
    )}

    <div class="price-table-wrap">
      <table class="price-table">
        <caption class="visually-hidden">{ui.home.pricesTitle}</caption>
        <thead>
          <tr>
            <th rowspan="2" scope="col">{ui.price.area}, {areaUnit[locale]}</th>
            {groups.map((group) => (
              <th colspan={group.plans.length} scope="colgroup">
                {group.service.name[locale]}
              </th>
            ))}
          </tr>
          <tr>
            {columns.map(({ plan }) => (
              <th scope="col" data-popular={plan.popular ? '' : undefined}>
                {plan.name[locale]}
              </th>
            ))}
          </tr>
        </thead>
        <tbody>
          {AREA_TIERS.map((tier, index) => (
            <tr>
              <th scope="row">{areaUpTo[locale]} {formatNumber(tier, locale)} {areaUnit[locale]}</th>
              {columns.map((column) => (
                <td
                  data-label={columnLabel(column)}
                  data-popular={column.plan.popular ? '' : undefined}
                >
                  {formatPrice(column.plan.tiers[index], locale)}
                </td>
              ))}
            </tr>
          ))}
          <tr>
            <th scope="row">{areaOver[locale]} 150 {areaUnit[locale]}</th>
            {/*
              В этой строке все ячейки одинаковые («Подробнее»), поэтому подписи
              для мобильных карточек не нужны: они пять раз повторяли бы одно
              и то же и весили больше остальных строк вместе.
            */}
            {columns.map(() => (
              <td>{ui.cta.details}</td>
            ))}
          </tr>
        </tbody>
      </table>
      <p class="price-table__caption">
        {columns.find(({ plan }) => plan.popular)?.plan.name[locale]} — {ui.price.popular.toLowerCase()}.
        {' '}
        {ui.calc.resultHint}
      </p>
    </div>
  </div>
</section>
