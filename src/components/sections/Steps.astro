---
import type { Locale } from '../../i18n/config';
import { useUI } from '../../i18n/ui';
import { steps } from '../../data/steps';

/** «Как мы работаем» — четыре шага с нумерацией. */
import SectionHead from './SectionHead.astro';
import Section from '../ui/Section.astro';

interface Props {
  locale: Locale;
  /** Заголовок секции выводить или нет (на странице услуги он уже есть). */
  withHead?: boolean;
  /** Серый фон секции (чередование полос на странице). */
  surface?: boolean;
}

const { locale, withHead = true, surface = false } = Astro.props;
const ui = useUI(locale);
---

<Section surface={surface} id="steps">
  {withHead && <SectionHead title={ui.home.stepsTitle} lead={ui.home.stepsLead} />}
  <div class="steps grid--auto">
    {steps.map((step, index) => (
      <div class="step" data-reveal>
        <span class="step__num num num--strong">{String(index + 1).padStart(2, '0')}</span>
        <h3 class="step__title">{step.title[locale]}</h3>
        <p class="step__text">{step.text[locale]}</p>
      </div>
    ))}
  </div>
</Section>
