---
import type { Locale } from '../../i18n/config';
import { href } from '../../i18n/routes';
import { useUI } from '../../i18n/ui';
import { site } from '../../data/site';

import Icon from '../ui/Icon.astro';
import SectionHead from './SectionHead.astro';
import Section from '../ui/Section.astro';

/**
 * Форма заявки.
 *
 * Бэкенда нет и не планируется: сайт статический, отдаётся nginx.
 * Поэтому заявка не «отправляется», а собирается в готовое сообщение
 * и открывается в Telegram — заказчик жмёт «Отправить» уже в мессенджере.
 * Так работает и на GitHub Pages, и не требует ни почтового сервиса,
 * ни базы данных, ни согласия на обработку данных третьей стороной.
 *
 * Форма валидируется на клиенте и остаётся рабочей без JS: тогда поля
 * просто отправляются в Telegram как есть через ссылку-фолбэк.
 */

interface Props {
  locale: Locale;
  withHead?: boolean;
  /** Серый фон секции (чередование полос на странице). */
  surface?: boolean;
}

const { locale, withHead = true, surface = false } = Astro.props;
const ui = useUI(locale);

const times = [ui.form.timeMorning, ui.form.timeAfternoon, ui.form.timeEvening];

const whatsappUrl = site.phone ? `https://wa.me/${site.phone.replace(/[^0-9]/g, '')}` : null;
---

<Section surface={surface} id="booking">
  {withHead && <SectionHead title={ui.home.formTitle} lead={ui.home.formLead} />}

  <form class="form panel" data-booking novalidate data-tg={site.telegramUrl}>
    <div class="form__row grid--auto">
      <div class="form__field">
        <label class="form__label" for="booking-name">
          {ui.form.name}
        </label>
        <input
          class="form__input"
          id="booking-name"
          name="name"
          type="text"
          autocomplete="name"
          autocapitalize="words"
          enterkeyhint="next"
          required
          data-field="name"
          data-msg-label={ui.form.name}
          data-msg-error={ui.form.errorName}
        />
        <p class="form__error" id="booking-error-name" data-error="name" role="alert" hidden></p>
      </div>

      <div class="form__field">
        <label class="form__label" for="booking-contact">
          {ui.form.contact}
        </label>
        {/*
            type остаётся text, хотя поле и принимает телефон: в него можно
            написать и ник в Telegram, а tel-клавиатура на телефоне показывает
            только цифры и «+». Подсказка ниже прямо говорит об этом.
            enterkeyhint — чтобы клавиатура предлагала «Далее», а не «Готово».
          */}
        <input
          class="form__input"
          id="booking-contact"
          name="contact"
          type="text"
          autocomplete="tel"
          enterkeyhint="next"
          required
          data-field="contact"
          data-msg-label={ui.form.contact}
          data-msg-error={ui.form.errorContact}
        />
        <p class="field__hint">{ui.form.contactHint}</p>
        <p
          class="form__error"
          id="booking-error-contact"
          data-error="contact"
          role="alert"
          hidden
        ></p>
      </div>
    </div>

    <div class="form__row grid--auto">
      <div class="form__field">
        <label class="form__label" for="booking-district">
          {ui.form.address}
        </label>
        <input
          class="form__input"
          id="booking-district"
          name="district"
          type="text"
          placeholder={ui.form.addressPlaceholder}
          autocapitalize="sentences"
          enterkeyhint="next"
          data-field="district"
          data-msg-label={ui.form.address}
        />
      </div>

      <div class="form__field">
        <label class="form__label" for="booking-date">
          {ui.form.date}
        </label>
        <input
          class="form__input"
          id="booking-date"
          name="date"
          type="date"
          enterkeyhint="next"
          data-field="date"
          data-msg-label={ui.form.date}
        />
      </div>

      <div class="form__field">
        <label class="form__label" for="booking-time">
          {ui.form.time}
        </label>
        <select
          class="form__select"
          id="booking-time"
          name="time"
          data-field="time"
          data-msg-label={ui.form.time}
        >
          {times.map((slot) => (
            <option value={slot}>{slot}</option>
          ))}
        </select>
      </div>
    </div>

    <div class="form__field">
      <label class="form__label" for="booking-comment">
        {ui.form.comment}
      </label>
      <textarea
        class="form__textarea"
        id="booking-comment"
        name="comment"
        placeholder={ui.form.commentPlaceholder}
        enterkeyhint="done"
        data-field="comment"
        data-msg-label={ui.form.comment}
      ></textarea>
    </div>

    <label class="form__consent check-row">
      <input
        type="checkbox"
        name="consent"
        required
        data-field="consent"
        data-msg-error={ui.form.errorConsent}
      />
      <span>
        {ui.form.consent} — <a href={href(locale, 'privacy')}>{ui.footer.privacy}</a>
      </span>
    </label>
    <p class="form__error" id="booking-error-consent" data-error="consent" role="alert" hidden></p>

    <div class="form__actions">
      <button class="btn btn--lg btn--block" type="submit">
        <Icon name="telegram" class="btn__icon" />
        {ui.form.submit}
      </button>

      <p class="form__divider">{ui.form.orDirect}</p>

      <div class="form__alternatives">
        {whatsappUrl && (
          <a class="btn btn--ghost" href={whatsappUrl} target="_blank" rel="noopener noreferrer">
            <Icon name="whatsapp" class="btn__icon" />
            {ui.cta.whatsapp}
          </a>
        )}
        <a class="btn btn--ghost" href={site.telegramUrl} target="_blank" rel="noopener noreferrer">
          <Icon name="phone" class="btn__icon" />@{site.telegram}
        </a>
      </div>
    </div>

    <p class="form__error" data-error-open role="alert" hidden>
      {ui.form.errorOpen}
    </p>

    <p class="form__success" data-success role="status" hidden>
      <strong>{ui.form.successTitle}.</strong> {ui.form.successText}
    </p>
  </form>
</Section>

<script>
  /**
   * Валидация заявки и передача её в Telegram.
   *
   * Заявка не уходит на сервер: сайт статический. Мы собираем готовое
   * сообщение и открываем чат с менеджером — так заявка доходит даже
   * с GitHub Pages, где серверной логики нет вообще.
   *
   * Подписи и тексты ошибок живут в data-msg-* атрибутах самих
   * полей — скрипт не парсит JSON-строки, а читает значение
   * прямо у поля, которое показывает ошибку.
   *
   * Модель инстанцирования — querySelectorAll: форма на странице
   * одна, но скрипт не зависит от того, что элемент ровно один.
   */
  document.querySelectorAll<HTMLFormElement>('[data-booking]').forEach(initBookingForm);

  function initBookingForm(form: HTMLFormElement) {
    const field = <T extends HTMLElement>(name: string) =>
      form.querySelector<T>(`[data-field="${name}"]`);

    /** Подпись поля — из его же data-msg-label. */
    const label = (name: string) => field(name)?.dataset.msgLabel ?? '';

    function showError(name: string, message?: string) {
      const box = form.querySelector<HTMLElement>(`[data-error="${name}"]`);
      const input = field(name);
      if (!box) return;

      if (message) {
        box.textContent = message;
        box.hidden = false;
        input?.setAttribute('aria-invalid', 'true');
        // Связываем ошибку с полем: скринридер прочитает её вместе с ним,
        // а не как отдельное сообщение где-то ниже формы.
        input?.setAttribute('aria-describedby', box.id);
      } else {
        box.hidden = true;
        input?.removeAttribute('aria-invalid');
        input?.removeAttribute('aria-describedby');
      }
    }

    // Ошибка снимается, как только пользователь начал исправлять поле
    form.querySelectorAll<HTMLElement>('[data-field]').forEach((input) => {
      input.addEventListener('input', () => showError(input.dataset.field ?? ''));
      input.addEventListener('change', () => showError(input.dataset.field ?? ''));
    });

    form.addEventListener('submit', (event) => {
      event.preventDefault();

      const values = {
        name: field<HTMLInputElement>('name')?.value.trim() ?? '',
        contact: field<HTMLInputElement>('contact')?.value.trim() ?? '',
        district: field<HTMLInputElement>('district')?.value.trim() ?? '',
        date: field<HTMLInputElement>('date')?.value ?? '',
        time: field<HTMLSelectElement>('time')?.value ?? '',
        comment: field<HTMLTextAreaElement>('comment')?.value.trim() ?? '',
        consent: field<HTMLInputElement>('consent')?.checked ?? false,
      };

      let firstInvalid: HTMLElement | null = null;

      // Текст ошибки берём у самого поля: поле знает и подпись,
      // и формулировку ошибки — в скрипте ни одной строки контента.
      const check = (condition: boolean, name: string) => {
        if (condition) return;
        const input = field<HTMLElement>(name);
        showError(name, input?.dataset.msgError);
        if (!firstInvalid && input) firstInvalid = input;
      };

      check(Boolean(values.name), 'name');
      check(Boolean(values.contact), 'contact');
      check(values.consent, 'consent');

      if (firstInvalid) {
        (firstInvalid as HTMLElement).focus();
        return;
      }

      // Собираем сообщение: только заполненные строки, без пустых подписей
      const lines = [
        `${label('name')}: ${values.name}`,
        `${label('contact')}: ${values.contact}`,
        values.district && `${label('district')}: ${values.district}`,
        values.date && `${label('date')}: ${values.date}`,
        `${label('time')}: ${values.time}`,
        values.comment && `${label('comment')}: ${values.comment}`,
      ].filter(Boolean) as string[];

      const url = `${form.dataset.tg}?text=${encodeURIComponent(lines.join('\n'))}`;

      // Блокировщик popup может не дать открыть Telegram — тогда нельзя
      // показывать ложное «отправлено»: остаётся прямая ссылка ниже.
      const popup = window.open(url, '_blank', 'noopener');
      const openError = form.querySelector<HTMLElement>('[data-error-open]');
      const success = form.querySelector<HTMLElement>('[data-success]');

      if (popup) {
        if (openError) openError.hidden = true;
        if (success) success.hidden = false;
      } else if (openError) {
        openError.hidden = false;
      }
    });
  }
</script>
