---
import { formatPrice, type Locale } from '../../i18n/config';
import { href } from '../../i18n/routes';
import { useUI } from '../../i18n/ui';
import { getService } from '../../data/services';
import { AREA_TIERS, areaUnit, hourlyRate, plansForService } from '../../data/prices';
import { getChecklist } from '../../data/checklists';
import type { ServiceKey } from '../../i18n/routes';

import Icon from '../ui/Icon.astro';
import SectionHead from './SectionHead.astro';
import Checklist from './Checklist.astro';

/**
 * Страница услуги: описание, условия и прайс именно этой услуги.
 *
 * Всё берётся из тех же данных, что и на главной, поэтому страница услуги
 * не может «отстать» от общей таблицы цен. Чек-лист подключается только
 * если он есть — у Смарт Клининга его нет по определению услуги.
 */

interface Props {
  locale: Locale;
  serviceKey: ServiceKey;
}

const { locale, serviceKey } = Astro.props;
const ui = useUI(locale);

const service = getService(serviceKey);
const servicePlans = plansForService(serviceKey);
const checklist = getChecklist(serviceKey);
const isHourly = service.priceUnit === 'hour';

/**
 * Подписи колонок по площади — один источник на две задачи: заголовок
 * столбца в таблице (планшет и десктоп) и подпись строки в мобильной
 * карточке (data-label, см. components-blocks-b.css).
 *
 * Раньше это были шесть захардкоженных <th> вида «40 m²»: при правке
 * AREA_TIERS они расходились с данными, а локаль не учитывалась вовсе.
 */
const areaLabels = AREA_TIERS.map((tier) => `${tier} ${areaUnit[locale]}`);
---

<section class="section">
  <div class="container">
    <div class="split">
      <div class="prose">
        {service.description[locale].map((paragraph) => <p>{paragraph}</p>)}

        <h3>{ui.home.servicesTitle}</h3>
        <ul class="check-list">
          {service.highlights[locale].map((item) => (
            <li>
              <Icon name="check" />
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </div>

      <aside>
        <div class="card">
          <span class="icon-box"><Icon name={service.icon} /></span>
          <h2 class="card__title">{service.name[locale]}</h2>
          <p class="card__text">{service.lead[locale]}</p>

          <div class="price-list">
            <div class="price-row">
              <span class="price-row__name">{ui.calc.hoursLabel}</span>
              {/* Длительность — текст, а не число: на 360px фраза вида
                  «4–8 sati, zavisno od stanja i kvadrature» в одну строку
                  шире карточки, поэтому значение переносится по словам. */}
              <span class="price-row__value">{service.duration[locale]}</span>
            </div>
            {service.minOrder !== null && (
              <div class="price-row">
                <span class="price-row__name">{ui.price.minimum}</span>
                <span class="price-row__value price-row__value--num">
                  {isHourly
                    ? `${hourlyRate.minimumHours} × ${formatPrice(hourlyRate.price, locale)}`
                    : formatPrice(service.minOrder, locale)}
                </span>
              </div>
            )}
          </div>

          <a class="btn btn--block" href={href(locale, 'contact')}>
            <Icon name="telegram" class="btn__icon" />
            {ui.cta.book}
          </a>
        </div>

        <div class="card" style="margin-block-start:var(--s6)">
          <h3 class="card__title">{ui.price.included}</h3>
          <ul class="notes">
            {service.notes[locale].map((note) => <li>{note}</li>)}
          </ul>
        </div>
      </aside>
    </div>
  </div>
</section>

{isHourly && (
  <section class="section section--surface">
    <div class="container">
      <SectionHead title={ui.home.calculatorTitle} lead={ui.calc.smartHint} />
      <div class="callout">
        {hourlyRate.minimumHours} × {formatPrice(hourlyRate.price, locale)} ={' '}
        {formatPrice(hourlyRate.price * hourlyRate.minimumHours, locale)}
      </div>
    </div>
  </section>
)}

{servicePlans.length > 0 && (
  <section class="section section--surface">
    <div class="container">
      <SectionHead
        title={ui.home.pricesTitle}
        lead={ui.home.pricesLead}
      />
      <div class="price-table-wrap">
        <table class="price-table">
          <caption class="visually-hidden">{service.name[locale]}</caption>
          <thead>
            <tr>
              <th scope="col">{ui.price.included}</th>
              {areaLabels.map((label) => (
                <th scope="col">{label}</th>
              ))}
            </tr>
          </thead>
          <tbody>
            {servicePlans.map((plan) => (
              <tr data-popular={plan.popular ? '' : undefined}>
                <th scope="row">{plan.name[locale]}</th>
                {plan.tiers.map((price, index) => (
                  <td data-label={areaLabels[index]}>{formatPrice(price, locale)}</td>
                ))}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>
)}

{checklist && (
  <Checklist
    locale={locale}
    checklist={checklist}
    surface={servicePlans.length === 0}
  />
)}
