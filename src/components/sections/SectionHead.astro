---
/**
 * Заголовок секции: h2 и лид.
 * Один компонент на все блоки — поэтому ритм заголовков одинаков
 * по всему сайту и меняется в одном месте.
 */

interface Props {
  title: string;
  lead?: string;
}

const { title, lead } = Astro.props;
---

<div class="section-head" data-reveal>
  <h2>{title}</h2>
  {lead && <p class="section-head__lead">{lead}</p>}
  <slot />
</div>
