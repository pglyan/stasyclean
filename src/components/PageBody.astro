---
import type { AstroComponentFactory } from 'astro/runtime/server/index.js';
import type { Locale } from '../i18n/config';
import { isServiceKey, type PageKey, type ServiceKey } from '../i18n/routes';
import { getPageHead } from '../i18n/pagemeta';
import { useUI } from '../i18n/ui';
import { pageBlocks, type BlockId } from '../data/pages';
import type { Checklist as ChecklistData } from '../data/checklists';
import { checklists } from '../data/checklists';
import { getService } from '../data/services';
import { extraServices, windowServices } from '../data/extras';
import { siteText } from '../data/site';

import Hero from './sections/Hero.astro';
import PageHero from './sections/PageHero.astro';
import Usp from './sections/Usp.astro';
import Services from './sections/Services.astro';
import PriceTable from './sections/PriceTable.astro';
import Calculator from './sections/Calculator.astro';
import Checklist from './sections/Checklist.astro';
import PriceList from './sections/PriceList.astro';
import Steps from './sections/Steps.astro';
import BeforeAfter from './sections/BeforeAfter.astro';
import Reviews from './sections/Reviews.astro';
import Areas from './sections/Areas.astro';
import Faq from './sections/Faq.astro';
import BookingForm from './sections/BookingForm.astro';
import CtaBand from './sections/CtaBand.astro';
import ServiceDetail from './sections/ServiceDetail.astro';
import Legal from './sections/Legal.astro';

/**
 * Рендерер содержимого страницы.
 *
 * Собирает страницу из блоков, перечисленных в src/data/pages.ts.
 * Один блок — один компонент, поэтому одинаковый блок на разных страницах
 * выглядит одинаково и правится в одном месте.
 *
 * Заголовок и лид внутренней страницы приходят из src/i18n/pagemeta.ts —
 * того же реестра, что даёт имена хлебным крошкам в JSON-LD.
 */

interface Props {
  locale: Locale;
  routeKey: PageKey;
}

const { locale, routeKey } = Astro.props;
const ui = useUI(locale);

type Entry = { Component: AstroComponentFactory; props: Record<string, unknown> };

/**
 * Пара «компонент + его пропсы»: generic связывает пропсы с конкретным
 * компонентом, поэтому лишнее имя или забытый обязательный пропс ловит
 * TypeScript здесь, а не разметка страницы в браузере.
 */
function block<P>(_component: (props: P) => unknown, props: P): Entry {
  return {
    Component: _component as AstroComponentFactory,
    props: props as Record<string, unknown>,
  };
}

/** Ключ услуги для блока serviceDetail — только у страниц услуг. */
function serviceKeyOf(key: PageKey): ServiceKey {
  if (!isServiceKey(key)) {
    throw new Error(`Блок serviceDetail доступен только страницам услуг, получено «${key}».`);
  }
  return key;
}

/** Чек-лист услуги: отсутствие — ошибка данных, а не молчаливый пропуск. */
function requireChecklist(key: ServiceKey): ChecklistData {
  const list = checklists[key];
  if (!list) throw new Error(`Чек-лист «${key}» не найден в src/data/checklists.`);
  return list;
}

/** Порядок блоков и их опции для конкретной страницы. */
function buildBlocks(): Entry[] {
  const service = isServiceKey(routeKey) ? getService(routeKey) : null;
  const parentKey = service ? ('services' as const) : undefined;
  const head = getPageHead(locale, routeKey);

  /**
   * Реестр фабрик: пропсы собираются только для блоков, которые реально
   * есть на странице, — serviceDetail иначе требовал бы услугу у всех.
   */
  const registry: Record<BlockId, () => Entry> = {
    hero: () => block(Hero, { locale }),
    pageHero: () =>
      block(PageHero, {
        locale,
        routeKey,
        title: head.title,
        lead: head.lead || undefined,
        parentKey,
        photoHint:
          routeKey === 'privacy' || routeKey === 'terms'
            ? undefined
            : siteText.photoHintPage[locale],
      }),
    usp: () => block(Usp, { locale }),
    services: () => block(Services, { locale, withHead: routeKey !== 'home' }),
    priceTable: () => block(PriceTable, { locale, withHead: routeKey !== 'home', surface: true }),
    calculator: () => block(Calculator, { locale, withHead: routeKey !== 'home', surface: true }),
    checklist: () =>
      block(Checklist, {
        locale,
        // На главной показываем генеральную уборку — самый содержательный список
        checklist: requireChecklist('general'),
        surface: true,
      }),
    extras: () =>
      block(PriceList, {
        locale,
        title: ui.home.extrasTitle,
        lead: ui.home.extrasLead,
        lines: extraServices,
        id: 'extras',
      }),
    windows: () =>
      block(PriceList, {
        locale,
        title: ui.home.windowsTitle,
        lead: ui.home.windowsLead,
        lines: windowServices,
        id: 'windows',
        surface: true,
      }),
    steps: () => block(Steps, { locale }),
    beforeAfter: () => block(BeforeAfter, { locale }),
    reviews: () => block(Reviews, { locale, withHead: routeKey === 'home', limit: 4 }),
    areas: () => block(Areas, { locale, surface: true }),
    faq: () =>
      block(Faq, {
        locale,
        withHead: routeKey !== 'faq',
        limit: routeKey === 'home' ? 6 : undefined,
        surface: routeKey !== 'home',
      }),
    bookingForm: () => block(BookingForm, { locale }),
    ctaBand: () =>
      block(CtaBand, {
        locale,
        title: routeKey === 'home' ? undefined : ui.home.contactTitle,
        text: routeKey === 'home' ? undefined : ui.home.contactLead,
      }),
    serviceDetail: () => block(ServiceDetail, { locale, serviceKey: serviceKeyOf(routeKey) }),
    legal: () => block(Legal, { locale, doc: routeKey === 'terms' ? 'terms' : 'privacy' }),
  };

  return pageBlocks[routeKey].map((id) => registry[id]());
}

const blocks = buildBlocks();
---

{blocks.map(({ Component, props }) => (
  <Component {...props} />
))}
