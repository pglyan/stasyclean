---
import type { Locale } from '../i18n/config';
import { href, NAV_KEYS } from '../i18n/routes';
import { useUI } from '../i18n/ui';
import { hasLegal, site, siteText } from '../data/site';
import { services } from '../data/services';

import Icon from './ui/Icon.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const ui = useUI(locale);

/** В подвале не дублируем все страницы подряд — только навигационные. */
const legalKeys = ['privacy', 'terms'] as const;
---

<footer class="site-footer">
  <div class="container">
    <div class="footer__grid grid--auto">
      <div class="footer__col">
        <span class="brand">
          <span class="brand__mark" aria-hidden="true">
            <Icon name="sparkles" />
          </span>
          <span class="brand__name">{site.brand}</span>
        </span>
        <p class="footer__about">{siteText.tagline[locale]}</p>
      </div>

      <div class="footer__col">
        <h3>{ui.footer.services}</h3>
        <ul class="list-reset">
          {services.map((service) => (
            <li>
              <a href={href(locale, service.key)}>{service.name[locale]}</a>
            </li>
          ))}
        </ul>
      </div>

      <div class="footer__col">
        <h3>{ui.footer.navigation}</h3>
        <ul class="list-reset">
          {NAV_KEYS.map((key) => (
            <li>
              <a href={href(locale, key)}>{ui.nav[key]}</a>
            </li>
          ))}
        </ul>
      </div>

      <div class="footer__col">
        <h3>{ui.footer.contacts}</h3>
        <ul class="list-reset">
          <li>
            <a href={site.telegramUrl} target="_blank" rel="noopener noreferrer">
              Telegram @{site.telegram}
            </a>
          </li>
          <li>
            <a href={site.instagramUrl} target="_blank" rel="noopener noreferrer">
              Instagram @{site.instagram}
            </a>
          </li>
          {site.phone && (
            <li>
              <a href={`tel:${site.phone.replace(/\s/g, '')}`}>{site.phone}</a>
            </li>
          )}
          {site.email && (
            <li>
              <a href={`mailto:${site.email}`}>{site.email}</a>
            </li>
          )}
        </ul>
      </div>

      <div class="footer__col">
        <h3>{ui.footer.legal}</h3>
        <ul class="list-reset">
          {legalKeys.map((key) => (
            <li>
              <a href={href(locale, key)}>{ui.footer[key]}</a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <div class="footer__bottom">
      <p>
        © {new Date().getFullYear()} {site.brand}. {ui.footer.rights}.
      </p>
      <p class="footer__disclaimer">{ui.footer.disclaimer}</p>
      {!hasLegal() && <p class="footer__legal-pending">{ui.footer.pendingLegal}</p>}
    </div>
  </div>
</footer>
