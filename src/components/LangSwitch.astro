---
import { LOCALE_META } from '../i18n/config';
import { localeSwitchLinks, type PageKey } from '../i18n/routes';
import type { Locale } from '../i18n/config';
import { useUI } from '../i18n/ui';

import Icon from './ui/Icon.astro';

/**
 * Переключатель языка.
 *
 * Ключевое требование: ссылка ведёт на ТУ ЖЕ страницу в другой локали,
 * а не на главную. Это обеспечивает реестр маршрутов: слаг страницы
 * общий для языков (/prices → /ru/prices → /en/prices), меняется
 * только префикс локали.
 *
 * Сделан обычными ссылками: поисковики видят все локали, JS не нужен,
 * вес — ноль. Атрибут aria-current помогает скринридеру.
 *
 * Два вида одного переключателя:
 *   • .lang — три короткие ссылки в ряд. Это основной вид: десктопная
 *     шапка, шторка мобильного меню, подвал;
 *   • .lang-mobile — круглая кнопка с дропдауном. Её включает CSS
 *     только в шапке на узком экране: три ссылки в ряд занимали треть
 *     шапки. Дропдаун раскрывает JS (Header.astro), ссылки внутри —
 * те же, что в .lang. Компонент рендерится дважды на странице
 * (шапка + шторка), поэтому id дропдауна строится из переданного
 * `instance`: значение стабильно между сборками (в отличие от
 * crypto.randomUUID()) и уникально внутри страницы.
 */

interface Props {
  locale: Locale;
  routeKey: PageKey;
  /** Имя экземпляра («header» / «drawer») — для стабильного id дропдауна. */
  instance: string;
}

const { locale, routeKey, instance } = Astro.props;
const ui = useUI(locale);
const links = localeSwitchLinks(locale, routeKey);
const menuId = `lang-menu-${instance}`;
---

<nav class="lang" aria-label={LOCALE_META[locale].label}>
  {links.map((link) => (
    <a
      class="lang__item"
      href={link.href}
      hreflang={LOCALE_META[link.locale].htmlLang}
      lang={LOCALE_META[link.locale].htmlLang}
      aria-current={link.isCurrent ? 'true' : undefined}
      title={LOCALE_META[link.locale].label}
    >
      {LOCALE_META[link.locale].short}
    </a>
  ))}
</nav>

<div class="lang-mobile">
  <button
    class="lang-toggle"
    type="button"
    data-lang-toggle
    aria-expanded="false"
    aria-controls={menuId}
    aria-label={ui.nav.language}
  >
    <Icon name="globe" />
  </button>
  <div class="dropdown lang-menu" id={menuId} data-lang-menu>
    {links.map((link) => (
      <a
        href={link.href}
        hreflang={LOCALE_META[link.locale].htmlLang}
        lang={LOCALE_META[link.locale].htmlLang}
        aria-current={link.isCurrent ? 'true' : undefined}
      >
        {LOCALE_META[link.locale].label}
      </a>
    ))}
  </div>
</div>
