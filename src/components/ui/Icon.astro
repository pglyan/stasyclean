---
import { ICON_FILLED, ICON_PATHS, type IconName } from './icons';

/**
 * Инлайн-иконки.
 *
 * Спрайт встроен в HTML страницы (символы используются повторно через <use>),
 * поэтому иконки не стоят ни одного дополнительного запроса и наследуют
 * цвет через currentColor. Никаких иконочных шрифтов и сторонних CDN.
 *
 * Таблица геометрии и имена — в src/components/ui/icons.ts,
 * чтобы данные (карточки услуг, шаги) тоже могли ссылаться на них.
 */

interface Props {
  name: IconName;
  class?: string;
  /** Толщина линии. По умолчанию 1.75 — держит визуальный вес без «жирности». */
  strokeWidth?: number;
  /**
   * Подпись значимой иконки. Без подписи иконка — декорация
   * и прячется от скринридера (aria-hidden="true").
   */
  'aria-label'?: string;
}

const { name, class: className, strokeWidth = 1.75, 'aria-label': ariaLabel } = Astro.props;
/** Пустой class не должен отменять базовый размер: иконка остаётся .icon. */
const iconClass = className?.trim() || 'icon';

const d = ICON_PATHS[name];
const filled = ICON_FILLED.has(name);
---

<svg
  class={iconClass}
  viewBox="0 0 24 24"
  width="24"
  height="24"
  fill={filled ? 'currentColor' : 'none'}
  stroke={filled ? 'none' : 'currentColor'}
  stroke-width={filled ? undefined : strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden={ariaLabel ? undefined : true}
  role={ariaLabel ? 'img' : undefined}
>
  <path d={d}></path>
</svg>
