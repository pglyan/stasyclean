---
/**
 * Инлайн-иконки.
 *
 * Спрайт встроен в HTML страницы (символы используются повторно через <use>),
 * поэтому иконки не стоят ни одного дополнительного запроса и наследуют
 * цвет через currentColor. Никаких иконочных шрифтов и сторонних CDN.
 */

interface Props {
  name: string;
  class?: string;
  /** Толщина линии. По умолчанию 1.75 — держит визуальный вес без «жирности». */
  width?: number;
  'aria-hidden'?: boolean;
}

const { name, class: className = 'icon', width = 1.75, ...rest } = Astro.props;

