  ruler: 'M3.5 8.5h17v7h-17zM7 8.5v3M11 8.5v4M15 8.5v3M19 8.5v4',
  clock_alt: 'M12 20.5a8.5 8.5 0 1 0 0-17 8.5 8.5 0 0 0 0 17zM12 7.5V12l3 2',
  info: 'M12 20.5a8.5 8.5 0 1 0 0-17 8.5 8.5 0 0 0 0 17zM12 11v5M12 7.8v.01',
};

const d = paths[name] ?? paths.sparkles;
const strokeProps = name === 'whatsapp' || name === 'telegram' ? {} : { fill: 'none' };

// Иконки соцсетей рисуем заливкой — так они узнаваемее в маленьком размере
const filled = name === 'whatsapp' || name === 'telegram';
---

<svg
  class={className}
  viewBox="0 0 24 24"
  width="24"
  height="24"
  fill={filled ? 'currentColor' : 'none'}
  stroke={filled ? 'none' : 'currentColor'}
  stroke-width={filled ? undefined : width}
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden={rest['aria-hidden'] === false ? undefined : true}
  role={rest['aria-hidden'] === false ? 'img' : undefined}
  {...strokeProps}
>
  <path d={d}></path>
</svg>
