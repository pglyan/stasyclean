---
import type { Locale } from '../../i18n/config';
import { useUI } from '../../i18n/ui';
import { designForBuild } from '../../data/activeDesign';
import { schemeBrand, themeColors } from '../../themes/tokens';

import Icon from './Icon.astro';

/**
 * Переключатель светлой и тёмной схемы для шапки сайта.
 *
 * Это функция самого сайта, а не демо-стенда: посетитель должен уметь
 * выбрать тёмную тему на боевом домене, поэтому компонент рендерится
 * в Header.astro всегда, независимо от PUBLIC_DEMO. Тёмная вариация темы
 * уже едет в прод-CSS (generated-файл темы), не хватало только
 * кнопки — она и здесь.
 *
 * Кнопка — только иконка на всех размерах: подпись с текстом
 * переносилась внутри кнопки и расширяла шапку. Подпись называет
 * схему, В КОТОРУЮ переключит клик («Тёмная тема», пока открыта
 * светлая), и служит доступным именем: CSS прячет её из кадра, но
 * не из дерева доступности (свойства те же, что у .visually-hidden),
 * поэтому у иконочной кнопки имя остаётся. aria-label не ставим —
 * имя даёт этот же текст.
 *
 * Иконку показывает CSS по data-scheme на <html> (правила —
 * в components-chrome.css), поэтому JS состояние кнопки не дублирует:
 * он умеет только попросить применить противоположную схему
 * (initScheme из src/scripts/scheme.ts).
 */

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const ui = useUI(locale);

/**
 * Акценты обеих схем для <meta name="theme-color">. Натуральная схема темы
 * (её kind) — base-токены, вторая — alt. Та же логика, что в Base.astro.
 */
const theme = designForBuild.theme;
const colors = themeColors[theme.id];
const accentOf = (scheme: 'light' | 'dark') => schemeBrand(colors, theme.kind, scheme);
---

<button
  class="scheme-switch"
  type="button"
  data-scheme-switch
  data-color-light={accentOf('light')}
  data-color-dark={accentOf('dark')}
>
  <span class="scheme-switch__icon" data-scheme-show="dark" aria-hidden="true">
    <Icon name="moon" />
  </span>
  <span class="scheme-switch__icon" data-scheme-show="light" aria-hidden="true">
    <Icon name="sun" />
  </span>
  <span class="scheme-switch__label" data-scheme-show="dark">{ui.scheme.toDark}</span>
  <span class="scheme-switch__label" data-scheme-show="light">{ui.scheme.toLight}</span>
</button>